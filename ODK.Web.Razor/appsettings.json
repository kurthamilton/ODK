  "Stripe": {
    "ConnectedAccountBusinessName": "{platform.title} - {group.name}",
    "ConnectedAccountCommissionPercentage": 0,
    "ConnectedAccountMcc": "8641", // civic, fraternal, or social associations
    "ConnectedAccountProductDescription": "Paid memberships for community and social groups",
    // Where to open one of Stripe's own objects in its dashboard. An empty format means no link.
    "Dashboard": {
      "LiveInvoiceUrlFormat": "https://dashboard.stripe.com/{account}/invoices/{id}",
      "LivePaymentUrlFormat": "https://dashboard.stripe.com/{account}/payments/{id}",
      "LiveSubscriptionUrlFormat": "https://dashboard.stripe.com/{account}/subscriptions/{id}",
      "TestInvoiceUrlFormat": "https://dashboard.stripe.com/{account}/test/invoices/{id}",
      "TestPaymentUrlFormat": "https://dashboard.stripe.com/{account}/test/payments/{id}",
      "TestSubscriptionUrlFormat": "https://dashboard.stripe.com/{account}/test/subscriptions/{id}"
    },
    "Platforms": {
      "DK": {
        "AccountId": "",
        "ConnectedAccountBaseUrl": "https://drunkenknitwits.com",
        "PublicApiKey": "",
        "SecretApiKey": "",
        "WebhookSecretV1": "",
        "WebhookSecretV2": ""
      },
      "GS": {
        "AccountId": "",
        "ConnectedAccountBaseUrl": "https://groupsquirrel.com",
        "PublicApiKey": "",
        "SecretApiKey": "",
        "WebhookSecretV1": "",
        "WebhookSecretV2": ""
      }
    },
    // The number of seconds to wait before processing the settlement - including storing the data 
    // and transferring to the associated connected account.
    "SettlementReadDelaySeconds": 10,
    "Webhooks": {
      // One list for every endpoint on every account - the endpoints are meant to be identical.
      "Events": [
        "checkout.session.completed",
        "checkout.session.expired",
        "invoice.payment_succeeded",
        "customer.subscription.deleted"
      ],
      // The host a record's endpoints must be on, keyed by the record's environment then its platform.
      "Hosts": {
        "Prod": {
          "DK": "",
          "GS": ""
        },
        "Dev": {
          "DK": "",
          "GS": ""
        },
        "E2E": {
          "DK": "",
          "GS": ""
        }
      },
      "LiveDashboardUrlFormat": "https://dashboard.stripe.com/{account}/workbench/webhooks/{id}",
      "Path": "/webhooks/stripe",
      "TestDashboardUrlFormat": "https://dashboard.stripe.com/{account}/test/workbench/webhooks/{id}"
    }
  },
  "Subscriptions": {
    "DefaultCooldownMonths": 1
  },
  "WhatsApp": {
    "UrlFormat": "https://chat.whatsapp.com/{groupid}"
  }
