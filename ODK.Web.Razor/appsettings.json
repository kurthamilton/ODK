{
  "Auth": {
    "CookieLifetimeDays": 30,
    "PasswordResetTokenLifetimeMinutes": 30,
    "Passwords": {
      "Algorithm": "",
      "Iterations": 0,
      "MinLength": 8
    }
  },
  "BetterStack": {
    /* A source per platform, so a question about one platform's logs is not read against the other's
       traffic. A source is its ingesting host and its token together - BetterStack issues a host per source
       and recommends posting to it rather than to a shared endpoint - so either one left blank reads as
       unstated and turns the sink off for that platform. */
    "Platforms": {
      "Default": {
        "IngestingHost": "",
        "SourceToken": ""
      },
      "DrunkenKnitwits": {
        "IngestingHost": "",
        "SourceToken": ""
      }
    }
  },
  "Brevo": {
    "ApiKey": "",
    "EnvironmentTagPrefix": "",
    "WebhookPassword": "",
    "WebhookPasswordHeader": ""
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedMethods": "GET,POST,PUT,PATCH,DELETE,OPTIONS",
    "AllowedHeaders": "*"
  },
  "Emails": {
    "DebugEmailAddress": null,
    /* Each platform addresses its own emails and supplies the titles a group inherits where it has set
       none of its own. A title is a template over the email's other parameters. */
    "Platforms": {
      "Default": {
        "AdminTitle": "{group.name}",
        "FromEmailAddress": "",
        "MemberTitle": "{group.name}"
      },
      "DrunkenKnitwits": {
        "AdminTitle": "{group.name}",
        "FromEmailAddress": "",
        "MemberTitle": "{group.name}"
      }
    },
    "UseConsoleClient": false,
    "Theme": {
      "Body": {
        "Background": "#fff",
        "Color": "#3c4858"
      },
      "Header": {
        "Background": "#f00",
        "Color": "#fff"
      }
    }
  },
  "Environment": "None",
  "Events": {
    "ShortcodeLength": 8
  },
  "Google": {
    "Geolocation": {
      "ApiKey": ""
    },
    "Maps": {
      "ApiKey": ""
    }
  },
  "Groups": {
    "DefaultCountryCode": "",
    "ReservedSlugs": []
  },
  "Hangfire": {
    "InMemory": false,
    /* The storage a site enqueues to and dequeues from, per platform. A Hangfire server takes any job it
       finds in its own storage, so every deployment sharing this database needs a schema of its own or each
       runs the other's jobs. Hangfire creates the schema on start if it is missing.

       The names are deliberately numbered rather than named after a platform, so renaming a platform never
       strands a schema. Stated here rather than per deployment because they are the same wherever the app
       runs - a local instance queues in memory and reads neither. */
    "Platforms": {
      "Default": {
        "SchemaName": "Hangfire2"
      },
      "DrunkenKnitwits": {
        "SchemaName": "Hangfire"
      }
    },
    "RetryAttempts": 3,
    "WorkerCount": 1
  },
  "Hibp": {
    "Enabled": true,
    "RangeApiUrl": "https://api.pwnedpasswords.com/range/"
  },
  "Imaging": {
    /* Rejects an image whose decoded pixel count exceeds this, before it is decoded. Sized to clear any
       phone or camera photo while refusing the dimensions that make a small file allocate hundreds of
       megabytes. Counts pixels, not file bytes, because pixels are what a decode allocates. */
    "MaxPixels": 40000000
  },
  "Instagram": {
    "BaseUrl": "https://www.instagram.com",
    "Client": {
      "Cookies": {},
      "GraphQL": {
        "PostsDocId": ""
      },
      "Headers": {}
    },
    "FetchWaitSeconds": 10,
    "Paths": {
      "Channel": "/{username}",
      "GraphQL": "/graphql/query",
      "Post": "/p/{id}",
      "Tag": "/explore/tags/{tag}"
    }
  },
  "Localisation": {
    "DefaultLocale": "en-GB"
  },
  "Logging": {
    "IgnoreExceptions": [],
    "LogLevel": {
      "Default": "Information",
      "Hangfire": "None"
    },
    /* A log directory per platform, since each platform's instance is a process of its own and Serilog holds
       the file it opens. Environment-specific, so each states its own. */
    "Platforms": {
      "Default": {
        "Path": ""
      },
      "DrunkenKnitwits": {
        "Path": ""
      }
    }
  },
  "Members": {
    "AvatarSize": 75
  },
  "OAuth": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Payments": {
    "Active": "Stripe"
  },
  "PayPal": {
    "ApiBaseUrl": "https://api-m.sandbox.paypal.com",
    "ApiPublicKey": "",
    "ApiSecretKey": ""
  },
  /* The platform this deployment serves. Every deployment states its own - a prod site through its PLATFORM
     environment Variable, a local instance through its launch profile, which is the one place the value can
     be an environment variable: MSBuild reads its own Platform property from the environment, so setting it
     in a shell that builds relocates the whole build (see Scripts\app\run.bat). */
  "Platform": "None",
  "Platforms": {
    "Default": {
      "Name": "Group Squirrel",
      "Url": ""
    },
    "DrunkenKnitwits": {
      "Name": "Drunken Knitwits",
      "Url": ""
    }
  },
  "RateLimiting": {
    "BlockIpAddresses": [],
    "BlockPaths": [],
    "BlockPatterns": [],
    "BlockForSeconds": 0
  },
  "Recaptcha": {
    "Enabled": true,
    "ScoreThreshold": 0.5,
    "SecretKey": "",
    "SiteKey": "",
    "VerifyUrl": "https://www.google.com/recaptcha/api/siteverify"
  },
  "Reoon": {
    "ApiKey": "",
    "Mode": "power",
    "VerifyUrl": "https://emailverifier.reoon.com/api/v1/verify"
  },
  "ScheduledTasks": {
    "ApiKey": ""
  },
  "Stripe": {
    "ConnectedAccountBusinessName": "{platform.title} - {group.name}",
    "ConnectedAccountCommissionPercentage": 0,
    "ConnectedAccountMcc": "8641", // civic, fraternal, or social associations
    "ConnectedAccountProductDescription": "Paid memberships for community and social groups",
    "Platforms": {
      "Default": {
        "AccountId": "",
        "ConnectedAccountBaseUrl": "https://groupsquirrel.com",
        "PublicApiKey": "",
        "SecretApiKey": "",
        "WebhookSecretV1": "",
        "WebhookSecretV2": ""
      },
      "DrunkenKnitwits": {
        "AccountId": "",
        "ConnectedAccountBaseUrl": "https://drunkenknitwits.com",
        "PublicApiKey": "",
        "SecretApiKey": "",
        "WebhookSecretV1": "",
        "WebhookSecretV2": ""
      }
    },
    // The number of seconds to wait before processing the settlement - including storing the data 
    // and transferring to the associated connected account.
    "SettlementReadDelaySeconds": 10,
    "Webhooks": {
      // One list for every endpoint on every account - the endpoints are meant to be identical.
      "Events": [
        "checkout.session.completed",
        "checkout.session.expired",
        "invoice.payment_succeeded",
        "customer.subscription.deleted"
      ],
      // The host a record's endpoints must be on, keyed by the record's environment then its platform.
      "Hosts": {
        "Prod": {
          "Default": "",
          "DrunkenKnitwits": ""
        },
        "Dev": {
          "Default": "",
          "DrunkenKnitwits": ""
        },
        "E2E": {
          "Default": "",
          "DrunkenKnitwits": ""
        }
      },
      "LiveDashboardUrlFormat": "https://dashboard.stripe.com/{account}/workbench/webhooks/{id}",
      "Path": "/webhooks/stripe",
      "TestDashboardUrlFormat": "https://dashboard.stripe.com/{account}/test/workbench/webhooks/{id}"
    }
  },
  "Subscriptions": {
    "DefaultCooldownMonths": 1
  },
  "WhatsApp": {
    "UrlFormat": "https://chat.whatsapp.com/{groupid}"
  }
}