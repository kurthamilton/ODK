@page "/my/groups/{chapterId:guid}/siteadmin/members"
@using ODK.Services.Chapters
@using ODK.Web.Razor.Models.Components
@model MembersModel
@inject IChapterSiteAdminService ChapterSiteAdminService
@{
    Layout = "_GroupAdminLayout";
    Model.Title = "Members | Site Admin";

    var request = Model.MemberChapterServiceRequest;
    var viewModel = await ChapterSiteAdminService.GetChapterAdminMembersViewModel(request);
}

@await Html.PartialAsync("Components/_TwoColLeftMenu", new TwoColLeftMenuViewModel
{
    Title = "Members",
    BodyContentFunc = @<div>@await Html.PartialAsync("SiteAdmin/_SiteAdminAdminMembersContent", viewModel)</div>,
    MenuContentFunc = _ => Html.PartialAsync("Admin/_AdminSideMenu")
})
