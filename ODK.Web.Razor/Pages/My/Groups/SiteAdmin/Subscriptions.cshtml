@page "/my/groups/{chapterId:guid}/siteadmin/subscriptions"
@using ODK.Services.Chapters
@using ODK.Web.Razor.Models.Components
@model SubscriptionsModel
@inject IChapterSiteAdminService ChapterSiteAdminService
@{
    Layout = "_GroupAdminLayout";
    Model.Title = "Subscriptions | Site Admin";

    var request = Model.MemberChapterServiceRequest;
    var viewModel = await ChapterSiteAdminService.GetChapterSubscriptionsViewModel(request);
}

@await Html.PartialAsync("Components/_TwoColLeftMenu", new TwoColLeftMenuViewModel
{
    Title = "Subscriptions",
    BodyContentFunc = @<div>@await Html.PartialAsync("Chapters/SiteAdmin/_ChapterSubscriptionsContent", viewModel)</div>,
    MenuContentFunc = _ => Html.PartialAsync("Admin/_AdminSideMenu")
})
