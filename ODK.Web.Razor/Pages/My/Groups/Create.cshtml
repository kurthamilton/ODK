@page "/my/groups/new"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ODK.Core.Utils
@using ODK.Services.Chapters
@using ODK.Web.Razor.Models.Chapters
@using ODK.Web.Razor.Models.Components
@model CreateModel
@inject IChapterViewModelService ChapterViewModelService
@{
    Layout = "_HomeLayout";
    Model.Title = "Create group";

    var viewModel = await ChapterViewModelService.GetChapterCreateViewModel(
        Model.MemberServiceRequest);
}

@await Html.PartialAsync("Components/_Body", new BodyViewModel
{
    Title = "Create group",
    WidthClass = "col-12 col-lg-8",
    Breadcrumbs = new[]
    {
        new MenuItem { Link = Model.OdkRoutes.GroupAdmin.Index().Path, Text = "My groups" },
        new MenuItem { Text = "Create" }
    },
    ContentFunc = 
        @<div>
            @if (viewModel.ChapterCount >= viewModel.ChapterLimit)
            {
                <div class="alert alert-danger">
                    You cannot create another group as you have reached your group limit of @viewModel.ChapterLimit.
                </div>

                @* Not a feature gate - the subscription allows groups, there are just none left - so this
                   doesn't go through _RestrictedFeature. It's still the same upgrade action, so it uses the
                   shared button rather than a second hand-rolled one. *@
                <div class="mt-3">
                    @await Html.PartialAsync("Components/_UpgradeButton", new UpgradeButtonViewModel
                    {
                        Chapter = null,
                        Platform = Model.Platform
                    })
                </div>
            }
            else
            {
                if (viewModel.ChapterLimit != null && viewModel.ChapterCount >= viewModel.ChapterLimit.Value - 1)
                {
                    <div class="alert alert-warning mb-3">
                        You have @viewModel.ChapterCount of @viewModel.ChapterLimit @StringUtils.Pluralise(viewModel.ChapterLimit.Value, "group").
                    </div>
                }

                <form method="post">

                    @await Html.PartialAsync("Groups/_GroupCreateForm", new CreateChapterFormViewModel
                    {
                        Countries = viewModel.Countries,
                        Lat = viewModel.MemberLocation?.LatLong.Lat,
                        Long = viewModel.MemberLocation?.LatLong.Long,
                        LocationName = viewModel.MemberLocation?.Name ?? string.Empty,
                        TopicGroups = viewModel.TopicGroups,
                        TopicIds = viewModel.MemberTopics.Select(x => x.TopicId).ToList(),
                        Topics = viewModel.Topics
                    })
                </form>
            }                        
        </div>    
})

@section styles
{
    @await Html.PartialAsync("Components/Styles/_ImagingStyles")
}

@section scripts
{
    @await Html.PartialAsync("Components/Scripts/_GoogleLocation")
    @await Html.PartialAsync("Components/Scripts/_ImagingScripts")
    <script src="~/js/odk.wizard.js" asp-append-version="true"></script>
}