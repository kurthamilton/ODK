@page "/my/groups/{chapterId:guid}/settings"
@using ODK.Services.Chapters
@using ODK.Web.Razor.Models.Components
@model SettingsModel
@inject IChapterAdminService ChapterAdminService
@{
    Layout = "_GroupAdminLayout";
    Model.Title = "Settings";

    var viewModel = await ChapterAdminService.GetChapterSettingsViewModel(
        Model.MemberChapterAdminServiceRequest);
}

@await Html.PartialAsync("Components/_TwoColLeftMenu", new TwoColLeftMenuViewModel
{
    BodyContentFunc = @<div>@await Html.PartialAsync("Admin/Chapter/_ChapterAdminSettingsContent", viewModel)</div>,
    MenuTitle = "Admin",
    MenuContentFunc = _ => Html.PartialAsync("Admin/_AdminSideMenu")
})

@section styles
{
    @await Html.PartialAsync("Components/Styles/_ImagingStyles")
}

@section scripts
{
    @await Html.PartialAsync("Components/Scripts/_ImagingScripts")
    @await Html.PartialAsync("Components/Scripts/_GoogleLocation")
}
