@page "/my/groups/{chapterId:guid}/questions"
@using ODK.Services.Chapters
@using ODK.Web.Razor.Models.Components
@model IndexModel
@inject IChapterAdminService ChapterAdminService
@{
    Layout = "_GroupAdminLayout";
    Model.Title = "FAQ";

    var viewModel = await ChapterAdminService.GetChapterQuestionsViewModel(Model.MemberChapterAdminServiceRequest);
}

@await Html.PartialAsync("Components/_TwoColLeftMenu", new TwoColLeftMenuViewModel
{
    Title = "FAQ",
    BodyContentFunc = @<div>@await Html.PartialAsync("Admin/Chapter/_ChapterAdminQuestionsContent", viewModel)</div>,
    MenuTitle = "Admin",
    MenuContentFunc = _ => Html.PartialAsync("Admin/_AdminSideMenu")
})