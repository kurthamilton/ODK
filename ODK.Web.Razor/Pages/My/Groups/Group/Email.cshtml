@page "/my/groups/{chapterId:guid}/emails/{type}"
@using ODK.Services.Emails
@using ODK.Web.Razor.Models.Admin.Chapters
@using ODK.Web.Razor.Models.Components
@model EmailModel
@inject IEmailAdminService EmailAdminService
@{
    Layout = "_GroupAdminLayout";
    Model.Title = "Email template";

    var email = await EmailAdminService.GetChapterEmail(Model.MemberChapterAdminServiceRequest, Model.Type);
    var viewModel = new ChapterEmailContentViewModel
    {
        CanOverride = email.CanOverride,
        Chapter = Model.Chapter,
        Email = email.Email,
        Parameters = email.Parameters,
        RecipientType = email.RecipientType,
        SiteEmail = email.SiteEmail,
        Title = email.Title
    };
}

@await Html.PartialAsync("Components/_TwoColLeftMenu", new TwoColLeftMenuViewModel
{
    Title = email.Email.Name,
    Breadcrumbs = new BreadcrumbsViewModel
    {
        Breadcrumbs = new[]
        {
            new MenuItem
            {
                Link = Model.OdkRoutes.GroupAdmin.Emails(Model.Chapter).Path,
                Text = "Back to email templates",
                Icon = IconType.ArrowLeft
            }
        }
    },
    BodyContentFunc = @<div>@await Html.PartialAsync("Admin/Chapter/_ChapterAdminEmailContent", viewModel)</div>,
    MenuContentFunc = _ => Html.PartialAsync("Admin/_AdminSideMenu")
})

@section scripts {
    <script src="~/js/odk.bundle.code-editor.js" asp-append-version="true"></script>
}
