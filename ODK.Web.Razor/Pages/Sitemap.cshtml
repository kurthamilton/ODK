@page "/sitemap"
@using ODK.Core.Platforms
@using ODK.Services.Chapters
@using ODK.Services.Sitemap
@using ODK.Web.Razor.Models.Components
@model SitemapModel
@inject IChapterService ChapterService
@inject ISitemapService SitemapService
@{
    Layout = "_HomeLayout";
    Model.Title = "Sitemap";
    Model.Description = "Every page on the site that does not need an account";
    
    var viewModel = await SitemapService.GetSitemapViewModel(Model.ServiceRequest);
    var nodes = Model.OdkRoutes.Public.Sitemap(viewModel);
}

@if (Model.Platform == PlatformType.DrunkenKnitwits)
{
    var headerViewModel = await ChapterService.GetOdkHomeHeaderViewModel();
    @await Html.PartialAsync("Header/_OdkHomeHeader", headerViewModel)
}

@await Html.PartialAsync("Components/_Body", new BodyViewModel
{
    Content = await Html.PartialAsync("Sitemap/_SitemapBody", nodes),
    Title = "Sitemap"
})
