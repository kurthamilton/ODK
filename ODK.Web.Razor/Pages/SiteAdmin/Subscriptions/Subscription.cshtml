@page "/siteadmin/subscriptions/{id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ODK.Services.Subscriptions
@using ODK.Web.Razor.Models.Components
@model SubscriptionModel
@inject ISiteSubscriptionAdminService SiteSubscriptionAdminService
@{
    Layout = "_SiteAdminLayout";
    Model.Title = "Subscription | Site Admin";

    var viewModel = await SiteSubscriptionAdminService.GetSubscriptionEditViewModel(Model.MemberServiceRequest, Model.SubscriptionId);
}

@await Html.PartialAsync("Components/_Breadcrumbs", new BreadcrumbsViewModel
{
    Breadcrumbs = new[]
    {
        new MenuItem { Link = Model.OdkRoutes.SiteAdmin.Subscriptions.Path, Text = "Subscriptions" },
        new MenuItem { Text = viewModel.Subscription.Name }
    }
})

@await Html.PartialAsync("SiteAdmin/_SiteAdminSubscriptionContent", viewModel)