@page "/siteadmin/referrals/new"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ODK.Web.Razor.Models.Components
@model ReferralCampaignCreateModel
@{
    Layout = "_SiteAdminLayout";
    Model.Title = "Create referral campaign | Site Admin";
}

@await Html.PartialAsync("Components/_Breadcrumbs", new BreadcrumbsViewModel
{
    Breadcrumbs = new[]
    {
        new MenuItem { Link = Model.OdkRoutes.SiteAdmin.Referrals.Path, Text = "Referrals" },
        new MenuItem { Text = "New" }
    }
})

@await Html.PartialAsync("SiteAdmin/_ReferralCampaignCreateContent")
