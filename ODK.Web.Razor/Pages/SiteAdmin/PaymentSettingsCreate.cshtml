@page "/siteadmin/payments/new"
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Models.SiteAdmin
@model PaymentSettingsCreateModel
@{
    Layout = "_SiteAdminLayout";
    Model.Title = "Payments | SiteAdmin";
}

@await Html.PartialAsync("Components/_Breadcrumbs", new BreadcrumbsViewModel
{
    Breadcrumbs = new[]
    {
        new MenuItem { Link = Model.OdkRoutes.SiteAdmin.Payments.Path, Text = "Payments" },
        new MenuItem { Text = "New" }
    }
})

<form action="/siteadmin/payments" method="post">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("SiteAdmin/_SitePaymentSettingsForm", new SitePaymentSettingsFormViewModel
    {
        Active = false,
        SitePaymentSettingId = null
    })
    <button class="btn btn-primary">Create</button>
</form>