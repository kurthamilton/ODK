@page "/siteadmin/emails/{type}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ODK.Services.Emails
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Models.SiteAdmin
@model EmailModel
@inject IEmailAdminService EmailAdminService
@{
    Layout = "_SiteAdminLayout";
    Model.Title = "Edit email | Site Admin";

    var email = await EmailAdminService.GetSiteEmail(Model.MemberServiceRequest, Model.Type);
}

@await Html.PartialAsync("Components/_Breadcrumbs", new BreadcrumbsViewModel
{
    Breadcrumbs = new[]
    {
        new MenuItem { Link = Model.OdkRoutes.SiteAdmin.Emails.Path, Text = "Emails" },
        new MenuItem { Text = email.Email.Name }
    }
})

@await Html.PartialAsync("SiteAdmin/_SiteAdminEmailContent",
    new EmailContentViewModel(email.Email, email.Parameters, email.Title))

@section scripts {
    <script src="~/js/odk.bundle.code-editor.js" asp-append-version="true"></script>
}