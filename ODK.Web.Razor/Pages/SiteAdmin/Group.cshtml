@page "/siteadmin/groups/{slug}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ODK.Services.Chapters
@model GroupModel
@inject IChapterSiteAdminService ChapterSiteAdminService
@{
    Layout = "_SiteAdminLayout";
    Model.Title = "Group | Site Admin";

    var request = Model.MemberChapterServiceRequest;
    var viewModel = await ChapterSiteAdminService.GetSiteAdminChapterViewModel(request);
}

@await Html.PartialAsync("SiteAdmin/_SiteAdminGroupContent", viewModel)