@page "/siteadmin/impersonate"
@using Microsoft.AspNetCore.Authorization
@using ODK.Services.Authentication
@using ODK.Services.Members
@using ODK.Web.Common.Extensions
@attribute [Authorize(Roles = OdkRoles.SiteAdmin)]
@model ImpersonateModel
@inject IMemberAdminService MemberAdminService
@{
    Layout = "_SiteAdminLayout";

    var viewModel = await MemberAdminService.GetSiteAdminMemberSearchViewModel(
        Model.MemberServiceRequest, Model.Search, User.SignedInMemberIds());
}

@await Html.PartialAsync("SiteAdmin/_ImpersonateContent", viewModel)
