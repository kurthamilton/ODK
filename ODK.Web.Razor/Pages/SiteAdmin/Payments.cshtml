@page "/siteadmin/payments"
@using ODK.Services.Payments
@model PaymentsModel
@inject IPaymentAdminService PaymentAdminService
@{
    Layout = "_SiteAdminLayout";
    Model.Title = "Payments | Site Admin";

    var viewModel = await PaymentAdminService.GetSitePayments(Model.MemberServiceRequest);
}

@await Html.PartialAsync("SiteAdmin/_SiteAdminPaymentsContent", viewModel)
