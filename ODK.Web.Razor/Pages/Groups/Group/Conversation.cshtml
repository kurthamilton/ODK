@page "/groups/{slug}/conversations/{id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ODK.Services.Chapters
@using ODK.Web.Razor.Models.Chapters
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Models.Conversations
@using ODK.Web.Razor.Models.Groups
@model ConversationModel
@inject IChapterViewModelService ChapterViewModelService
@{
    Layout = "_HomeLayout";

    var viewModel = await ChapterViewModelService.GetGroupConversationPage(
        Model.MemberChapterServiceRequest, Model.ConversationId);

    Model.Title = $"{viewModel.Conversation.Subject} | My conversations | {viewModel.Chapter.GetDisplayName(Model.Platform)}";
}

@await Html.PartialAsync("Groups/_GroupBody", new GroupBodyViewModel
{
    Title = "",
    Content = await Html.PartialAsync("Conversations/_ConversationContent", new ConversationViewModel
    {
        Breadcrumbs =
        [
            new MenuItem { Text = "My conversations", Link = Model.OdkRoutes.Groups.Conversations(Model.Chapter) },
            new MenuItem { Text = viewModel.Conversation.Subject }
        ],
        ArchivedUtc = viewModel.Conversation.ArchivedUtc,
        ArchiveUrl = $"/conversations/{viewModel.Conversation.Id}/archive",
        ConversationId = viewModel.Conversation.Id,
        ConversationUrlFunc = id => Model.OdkRoutes.Groups.Conversation(chapter: Model.Chapter, id),
        CurrentMember = Model.CurrentMember,
        Messages = viewModel.Messages.ToViewModels(),
        OtherConversations = viewModel.OtherConversations.ToViewModels(),
        ReplyUrl = $"/conversations/{viewModel.Conversation.Id}/reply",
        RestoreUrl = $"/conversations/{viewModel.Conversation.Id}/restore",
        Subject = viewModel.Conversation.Subject
    }),
    Group = viewModel
})
