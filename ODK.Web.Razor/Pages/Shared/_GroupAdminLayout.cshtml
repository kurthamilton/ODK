@using ODK.Web.Common.Services
@using ODK.Web.Razor.Models.Components
@inject IRequestStore RequestStore
@{
    Layout = "_HomeLayout";

    var platform = RequestStore.Platform;        
    var chapter = RequestStore.Chapter;

    var customTheme = "";

    if (!string.IsNullOrEmpty(chapter.ThemeBackground))
    {
        customTheme += $"--theme-bg: {chapter.ThemeBackground};";
    }

    if (!string.IsNullOrEmpty(chapter.ThemeColor))
    {
        customTheme += $"--theme-color: {chapter.ThemeColor};";
    }

    // Rendered here rather than inside ContentFunc: a Razor template containing @await compiles to a
    // deferred async write, and _Body invokes ContentFunc synchronously - so RenderBody() would run after
    // the layout has already checked that it was called, and the request fails. _Body writes Content
    // before ContentFunc, so the alert still lands above the page body.
    var statusAlert = await Html.PartialAsync("Admin/Groups/_GroupStatusAlert", chapter);
}

@section styles
{
    @await RenderSectionAsync("styles", required: false)
}

<div style="@customTheme">
    @await Html.PartialAsync("Components/_Body", new BodyViewModel
    {
        Title = chapter.GetDisplayName(platform),
        Content = statusAlert,
        ContentFunc = _ => RenderBody()
    })
</div>

@section scripts
{
    <script src="~/js/odk.admin.js" asp-append-version="true"></script>
    <script src="~/js/odk.lists.js" asp-append-version="true"></script>
    @await RenderSectionAsync("scripts", required: false)
}
