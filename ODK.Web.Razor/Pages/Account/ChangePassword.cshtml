@page "/account/password/change"
@attribute [Authorize]
@using ODK.Web.Razor.Models.Account
@using ODK.Web.Razor.Models.Components
@using Microsoft.AspNetCore.Authorization
@model ChangePasswordModel
@{
    Layout = "_HomeLayout";
    Model.Title = "Change password";
}

@await Html.PartialAsync("Components/_Body", new BodyViewModel
{
    Title = "Account",
    Content = await Html.PartialAsync("Account/_SiteAccountLayout", new SiteAccountLayoutViewModel
    {
        Active = Model.OdkRoutes.Account.PasswordChange(chapter: null),
        Title = "Change password",
        Content =
            @<div>
                @await Html.PartialAsync("Account/_ChangePasswordContent")
            </div>
    })
})