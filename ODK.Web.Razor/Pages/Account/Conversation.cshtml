@page "/account/conversations/{id:guid}"
@using ODK.Web.Razor.Models.Conversations
@using Microsoft.AspNetCore.Authorization
@using ODK.Services.Members
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Account
@using ODK.Web.Razor.Models.Chapters
@using ODK.Web.Razor.Models.Components
@attribute [Authorize]
@model ConversationModel
@inject IMemberViewModelService MemberViewModelService
@inject IOdkRoutes OdkRoutes
@{
    Layout = "_HomeLayout";

    var viewModel = await MemberViewModelService.GetMemberConversationPage(
        Model.MemberServiceRequest, Model.ConversationId);

    Model.Title = $"{viewModel.Conversation.Subject} | My conversations";
}

@await Html.PartialAsync("Components/_Body", new BodyViewModel
{
    Title = "Account",
    Content = await Html.PartialAsync("Account/_SiteAccountLayout", new SiteAccountLayoutViewModel
    {
        Active = Model.OdkRoutes.Account.Conversations(null),
        Title = "Conversation",
        Content =
            @<div>
                @await Html.PartialAsync("Conversations/_ConversationContent", new ConversationViewModel
                {
                    Breadcrumbs =
                    [
                        new MenuItem
                        {
                            Link = OdkRoutes.Account.Conversations(chapter: null, archived: viewModel.Conversation.ArchivedUtc != null),
                            Text = "My conversations"
                        },
                        new MenuItem
                        {
                            Link = OdkRoutes.Groups.Group(viewModel.Chapter),
                            Text = viewModel.Chapter.GetDisplayName(Model.Platform)
                        },
                        new MenuItem
                        {
                            Text = viewModel.Conversation.Subject
                        }
                    ],
                    ArchivedUtc = viewModel.Conversation.ArchivedUtc,
                    ArchiveUrl = $"/conversations/{viewModel.Conversation.Id}/archive",
                    ConversationId = viewModel.Conversation.Id,
                    ConversationUrlFunc = id => OdkRoutes.Account.Conversation(chapter: null, id),
                    CurrentMember = Model.CurrentMember,
                    Messages = viewModel.Messages.ToViewModels(),
                    OtherConversations = viewModel.OtherConversations.ToViewModels(),
                    ReplyUrl = $"/conversations/{viewModel.Conversation.Id}/reply",
                    RestoreUrl = $"/conversations/{viewModel.Conversation.Id}/restore",
                    Subject = viewModel.Conversation.Subject
                })
            </div>
    })
})
