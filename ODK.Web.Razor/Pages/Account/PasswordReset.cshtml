@page "/account/password/reset"
@using ODK.Web.Razor.Models.Account
@using ODK.Web.Razor.Models.Components
@model PasswordResetModel
@{
    Layout = "_AccountLayout";
    Model.Title = "Reset password";
}

@await Html.PartialAsync("Components/_Body", new BodyViewModel
{
    Title = "Reset password",
    Breadcrumbs = new[]
    {
        @* ChapterOrDefault, not Chapter: the link in a reset email is followed by somebody who cannot sign
           in, and on Group Squirrel this route carries no chapter - Chapter throws where there is none. *@
        new MenuItem { Link = Model.OdkRoutes.Account.Login(Model.ChapterOrDefault), Text = "Login" },
        new MenuItem { Text = "Password reset" }
    },
    Content = await Html.PartialAsync("Account/_ResetPasswordForm", new ResetPasswordFormViewModel
    {
        Token = Model.Token
    })
})