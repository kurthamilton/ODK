@page "/account/site-conversations/{id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ODK.Services.Contact
@using ODK.Services.Platforms
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Account
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Models.Conversations
@using ODK.Web.Razor.Models.Messages
@model SiteConversationModel
@inject IContactService ContactService
@inject IOdkRoutes OdkRoutes
@inject IPlatformNameProvider PlatformNameProvider
@{
    // _AccountLayout rather than _HomeLayout: it carries the Drunken Knitwits header, which _HomeLayout
    // leaves to each page.
    Layout = "_AccountLayout";

    var viewModel = await ContactService.GetSiteConversationPage(Model.MemberServiceRequest, Model.ConversationId);
    Model.Title = viewModel.Conversation.Subject;

    var platformName = PlatformNameProvider.GetName(Model.Platform);
}

@await Html.PartialAsync("Components/_Body", new BodyViewModel
{
    Title = "Account",
    Content = await Html.PartialAsync("Account/_SiteAccountLayout", new SiteAccountLayoutViewModel
    {
        Active = OdkRoutes.Account.Conversations(null),
        Title = viewModel.Conversation.Subject,
        Content =
            @<div>
                <section class="section">
                    @await Html.PartialAsync("Conversations/_ConversationContent", new ConversationViewModel
                    {
                        ArchivedUtc = viewModel.Conversation.ArchivedUtc,
                        ArchiveUrl = $"/site-conversations/{viewModel.Conversation.Id}/archive",
                        Breadcrumbs =
                        [
                            new MenuItem
                            {
                                Link = OdkRoutes.Account.SiteConversations(viewModel.Conversation.ArchivedUtc != null),
                                Text = "My conversations"
                            },
                            new MenuItem { Text = viewModel.Conversation.Subject }
                        ],
                        ConversationId = viewModel.Conversation.Id,
                        ConversationUrlFunc = id => OdkRoutes.Account.SiteConversation(id),
                        CurrentMember = Model.CurrentMember,
                        Messages = viewModel.Messages.ToMemberViewModels(viewModel.Conversation, platformName),
                        OtherConversations = viewModel.OtherConversations.ToViewModels(),
                        ReplyUrl = $"/site-conversations/{viewModel.Conversation.Id}/reply",
                        RestoreUrl = $"/site-conversations/{viewModel.Conversation.Id}/restore",
                        Subject = viewModel.Conversation.Subject
                    })
                </section>
            </div>
    })
})
