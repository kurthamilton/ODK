@page "/account/interests"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Html
@using ODK.Services.Members
@using ODK.Web.Razor.Models.Account
@using ODK.Web.Razor.Models.Components
@model InterestsModel
@inject IMemberViewModelService MemberViewModelService
@{
    Layout = "_AccountLayout";
    Model.Title = "Interests";

    var viewModel = await MemberViewModelService.GetMemberInterestsPage(Model.MemberServiceRequest);

    // Declared here rather than inline below: the page content is already one inline markup block, and Razor
    // allows only one level of nesting.
    Func<object?, IHtmlContent> newTopics = @<div>
        <p>The following topics are pending approval</p>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Topic</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var newTopic in viewModel.NewTopics.OrderBy(x => x.TopicGroup).ThenBy(x => x.Topic))
                    {
                        <tr>
                            <td>@newTopic.TopicGroup</td>
                            <td>@newTopic.Topic</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>;
}

@await Html.PartialAsync("Components/_Body", new BodyViewModel
{
    Title = "Account",
    Content = await Html.PartialAsync("Account/_SiteAccountLayout", new SiteAccountLayoutViewModel
    {
        Active = Model.OdkRoutes.Account.Interests(),
        Title = "My interests",
        Content =
            @<div class="section-stack">
                @await Html.PartialAsync("Account/_InterestsContent", viewModel)

                @if (viewModel.NewTopics.Count > 0)
                {
                    @await Html.PartialAsync("Components/_Section", new SectionViewModel
                    {
                        Heading = new HeadingViewModel
                        {
                            Title = "New topics",
                            Type = HeadingType.H3
                        },
                        BodyContentFunc = newTopics
                    })
                }
            </div>
    })
})
