@page "/{chapterName}/admin/siteadmin/instagram"
@using ODK.Web.Razor.Models.Admin
@model InstagramModel
@{
    Layout = "_OdkChapterAdminLayout";
    Model.Title = "Instagram | Site Admin";

    var chapter = Model.Chapter;
}

@await Html.PartialAsync("Admin/_AdminBody", new AdminBodyViewModel
{
    Title = "Instagram",
    ContentFunc = @<div>@await Html.PartialAsync("SiteAdmin/_InstagramContent", chapter)</div>
})
