@page "/{chapterName}/admin/siteadmin/members"
@using ODK.Services.Chapters
@using ODK.Web.Razor.Models.Admin
@model MembersModel
@inject IChapterSiteAdminService ChapterSiteAdminService
@{
    Layout = "_OdkChapterAdminLayout";
    Model.Title = "Members | Site Admin";

    var request = Model.MemberChapterServiceRequest;
    var viewModel = await ChapterSiteAdminService.GetChapterAdminMembersViewModel(request);
}

@await Html.PartialAsync("Admin/_AdminBody", new AdminBodyViewModel
{
    Title = "Members",
    ContentFunc = @<div>@await Html.PartialAsync("SiteAdmin/_SiteAdminAdminMembersContent", viewModel)</div>
})
