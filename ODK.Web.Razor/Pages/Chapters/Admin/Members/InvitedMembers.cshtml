@page "/{chapterName}/admin/members/invited"
@using ODK.Services.Members
@using ODK.Web.Razor.Models.Admin
@using ODK.Web.Razor.Models.Components
@model InvitedMembersModel
@inject IMemberAdminService MemberAdminService
@{
    Layout = "_OdkChapterAdminLayout";
    Model.Title = "Invited members | Admin";

    var viewModel = await MemberAdminService.GetInvitedMembersViewModel(Model.MemberChapterAdminServiceRequest);
}

@await Html.PartialAsync("Admin/_AdminBody", new AdminBodyViewModel
{
    Title = "Invited members",
    Breadcrumbs = new[]
    {
        new MenuItem
        {
            Link = Model.AdminRoutes.Members(Model.Chapter).Path,
            Text = "Back to members",
            Icon = IconType.ArrowLeft
        }
    },
    ContentFunc = @<div>@await Html.PartialAsync("Admin/Members/_InvitedMembersContent", viewModel)</div>
})
