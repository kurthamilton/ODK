@page "/{chapterName}/admin/members/import"
@using ODK.Services.Members
@using ODK.Web.Razor.Models.Admin
@using ODK.Web.Razor.Models.Components
@model ImportMembersModel
@inject IMemberImportService MemberImportService
@{
    Layout = "_OdkChapterAdminLayout";
    Model.Title = "Import members | Admin";

    var viewModel = await MemberImportService.GetMemberImportViewModel(
        Model.MemberChapterAdminServiceRequest);
}

@await Html.PartialAsync("Admin/_AdminBody", new AdminBodyViewModel
{
    Title = "Import members",
    Breadcrumbs = new[]
    {
        new MenuItem
        {
            Link = Model.AdminRoutes.Members(Model.Chapter).Path,
            Text = "Back to members",
            Icon = IconType.ArrowLeft
        }
    },
    ContentFunc = @<div>@await Html.PartialAsync("Admin/Members/_ImportMembersContent", viewModel)</div>
})
