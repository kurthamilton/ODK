@page "/{chapterName}/admin/chapter/emails/{type}"
@using ODK.Services.Emails
@using ODK.Web.Razor.Models.Admin
@using ODK.Web.Razor.Models.Admin.Chapters
@using ODK.Web.Razor.Models.Components
@model EmailModel
@inject IEmailAdminService EmailAdminService
@{
    Layout = "_OdkChapterAdminLayout";
    Model.Title = "Email | Admin";

    var chapter = Model.Chapter;
    var email = await EmailAdminService.GetChapterEmail(Model.MemberChapterAdminServiceRequest, Model.Type);
    var viewModel = new ChapterEmailContentViewModel
    {
        CanOverride = email.CanOverride,
        Chapter = chapter,
        Email = email.Email,
        Parameters = email.Parameters,
        RecipientType = email.RecipientType,
        SiteEmail = email.SiteEmail,
        Title = email.Title
    };
}

@await Html.PartialAsync("Admin/_AdminBody", new AdminBodyViewModel
{
    Title = "",
    Breadcrumbs = new[]
    {
        new MenuItem { Link = Model.AdminRoutes.Emails(chapter).Path, Text = "Emails" },
        new MenuItem { Text = email.Email.Name }
    },
    ContentFunc = @<div>@await Html.PartialAsync("Admin/Chapter/_EmailContent", viewModel)</div>
})

@section scripts {
    <script src="~/js/odk.bundle.code-editor.js" asp-append-version="true"></script>
}