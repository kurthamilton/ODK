@page "/{chapterName}/admin/chapter/emails"
@using ODK.Services.Emails
@using ODK.Web.Razor.Models.Admin
@using ODK.Web.Razor.Models.Admin.Emails
@model EmailsModel
@inject IEmailAdminService EmailAdminService
@{
    Layout = "_OdkChapterAdminLayout";
    Model.Title = "Email templates | Admin";

    var request = Model.MemberChapterAdminServiceRequest;
    var emails = await EmailAdminService.GetChapterEmails(request);
    var viewModel = new ChapterEmailsViewModel
    {
        CanEdit = emails.CanEdit,
        Chapter = Model.Chapter,
        Emails = emails.Emails,
        Settings = emails.Settings,
        SiteAdminTitle = emails.SiteAdminTitle,
        SiteMemberTitle = emails.SiteMemberTitle
    };
}

@await Html.PartialAsync("Admin/_AdminBody", new AdminBodyViewModel
{
    Title = "Email templates",
    ContentFunc = @<div>@await Html.PartialAsync("Admin/Chapter/_ChapterAdminEmailsContent", viewModel)</div>
})