@page "/{chapterName}/account/profile"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using ODK.Core.Utils
@using ODK.Services.Users
@using ODK.Web.Razor.Models.Account
@using ODK.Web.Razor.Models.Components
@model ProfileModel
@inject IAccountViewModelService AccountViewModelService
@{
    Layout = "_OdkChapterLayout";
    Model.Title = "Profile";

    var viewModel = await AccountViewModelService.GetChapterProfilePage(Model.MemberChapterServiceRequest);
    var memberChapter = viewModel.CurrentMember.MemberChapter(viewModel.Chapter.Id);
    if (memberChapter == null)
    {
        return;
    }

    var dateJoined = memberChapter.CreatedUtc;
}

@await Html.PartialAsync("Components/_Body", new BodyViewModel
{
    Title = "Account",
    Content = await Html.PartialAsync("Components/_TwoColLeftMenu", new TwoColLeftMenuViewModel
    {
        Title = "Profile",
        MenuContentFunc = _ => Html.PartialAsync("Account/_AccountMenu", new AccountMenuViewModel
        {
            Chapter = viewModel.Chapter
        }),
        BodyContentFunc =
            @<div>
                <form method="post" action="/groups/@viewModel.Chapter.Id/profile">
                    @Html.AntiForgeryToken()

                    @await Html.PartialAsync("Account/_ChapterProfileForm", viewModel.ChapterProfile)

                    <div class="form-group mb-3">
                        <label class="form-label">Date joined</label>
                        <div class="form-control-plaintext">
                            <span>@dateJoined.ToFriendlyDateString(new FriendlyDateStringOptions
                                {
                                    FullMonthName = true,
                                    ForceIncludeYear = true,
                                    TimeZone = viewModel.CurrentMember.TimeZone
                                })</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Update</button>
                </form>
            </div>
    })
})