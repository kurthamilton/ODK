@page "/{chapterName}/account/conversations/{id:guid}"
@attribute [Authorize]
@using ODK.Web.Razor.Models.Conversations
@using Microsoft.AspNetCore.Authorization
@using ODK.Core.Platforms
@using ODK.Services.Chapters
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Chapters
@using ODK.Web.Razor.Models.Components
@model ConversationModel
@inject IChapterViewModelService ChapterViewModelService
@inject IOdkRoutes OdkRoutes
@{
    Layout = "_OdkChapterLayout";

    var viewModel = await ChapterViewModelService.GetGroupConversationPage(
        Model.MemberChapterServiceRequest, Model.ConversationId);

    Model.Title = $"{viewModel.Conversation.Subject} | My conversations";

    var breadcrumbs = new[]
    {
        new MenuItem 
        { 
            Link = OdkRoutes.Account.Conversations(Model.Chapter, archived: viewModel.Conversation.ArchivedUtc != null), 
            Text = "My conversations"
        },
        new MenuItem { Text = viewModel.Conversation.Subject }
    }
    .Where(x => !string.IsNullOrEmpty(x.Text))
    .ToArray();

    var conversationViewModel = new ConversationViewModel
    {
        Breadcrumbs = breadcrumbs,
        ArchivedUtc = viewModel.Conversation.ArchivedUtc,
        ArchiveUrl = $"/conversations/{viewModel.Conversation.Id}/archive",
        ConversationId = viewModel.Conversation.Id,
        ConversationUrlFunc = id => OdkRoutes.Groups.Conversation(chapter: Model.Chapter, id),
        CurrentMember = Model.CurrentMember,
        Messages = viewModel.Messages.ToViewModels(),
        OtherConversations = viewModel.OtherConversations.ToViewModels(),
        ReplyUrl = $"/conversations/{viewModel.Conversation.Id}/reply",
        RestoreUrl = $"/conversations/{viewModel.Conversation.Id}/restore",
        Subject = viewModel.Conversation.Subject
    };
}

@await Html.PartialAsync("Components/_Body", new BodyViewModel
{
    Title = "Conversation",
    Content = await Html.PartialAsync("Conversations/_ConversationContent", conversationViewModel)
})
