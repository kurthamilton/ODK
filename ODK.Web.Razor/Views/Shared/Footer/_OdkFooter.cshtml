@using ODK.Web.Common.Routes
@using ODK.Web.Common.Services
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Models.Footer
@model FooterViewModel
@inject IOdkRoutes OdkRoutes
@inject IRequestStore RequestStore

<footer>
    <section class="page-footer">
        <div class="container-md">
            <div class="row row-cols-1 row-cols-md-2">
                <div class="col">
                    <div>
                        <a href="/">Knitwits International Home</a>
                    </div>
                    <div>
                        <a href="@OdkRoutes.Site.Privacy">Privacy</a>
                    </div>
                    <div>
                        @* A signed-in member goes to their conversations, so contacting the site is
                           trackable rather than a message they never see again. /contact redirects them
                           there too, for anything still pointing at it. *@
                        @if (RequestStore.CurrentMemberOrDefault != null)
                        {
                            <a href="@OdkRoutes.Account.SiteConversations()">Contact</a>
                        }
                        else
                        {
                            <a href="@OdkRoutes.Site.Contact">Contact</a>
                        }
                    </div>
                </div>
                @if (Model.Links != null)
                {
                    <div class="col">
                        @await Html.PartialAsync("Components/_SocialMediaLinks", new SocialMediaLinksViewModel
                        {
                            Facebook = Model.Links.FacebookName,
                            Instagram = Model.Links.InstagramName,
                            ShowNames = true,
                            Twitter = Model.Links.TwitterName
                        })
                    </div>
                }                
            </div>
        </div>
    </section>
</footer>
