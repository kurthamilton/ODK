@using ODK.Core.Platforms
@using ODK.Web.Common.Routes
@using ODK.Web.Common.Services
@using ODK.Web.Razor.Models.Footer
@model FooterViewModel
@inject IOdkRoutes OdkRoutes
@inject IRequestStore RequestStore
@{
    if (RequestStore.Platform != PlatformType.Default)
    {
        return;
    }
}

<footer>
    <section class="page-footer">
        <div class="container-md">
            <div>
                <a href="/">Home</a>
            </div>
            <div>
                <a href="@OdkRoutes.Site.About">About</a>
            </div>
            <div>
                <a href="@OdkRoutes.Site.Privacy">Privacy</a>
            </div>
            <div>
                @* A signed-in member goes to their conversations, so contacting the site is trackable rather
                   than a message they never see again. /contact redirects them there too, for anything still
                   pointing at it. *@
                @if (RequestStore.CurrentMemberOrDefault != null)
                {
                    <a href="@OdkRoutes.Account.SiteConversations()">Contact</a>
                }
                else
                {
                    <a href="@OdkRoutes.Site.Contact">Contact</a>
                }
            </div>
            <div>
                <a href="@OdkRoutes.Site.Pricing">Pricing</a>
            </div>
        </div>
    </section>
</footer>