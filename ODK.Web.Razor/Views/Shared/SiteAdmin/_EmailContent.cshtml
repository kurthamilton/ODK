@using ODK.Core.Emails
@using ODK.Services.Emails.Parameters
@using ODK.Web.Razor.Models.Admin.Emails
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Models.SiteAdmin
@model EmailContentViewModel

@* No Custom badge: this is the template a group's customisation would be of. *@
@await Html.PartialAsync("Admin/Chapter/_EmailBadges", new EmailBadgesViewModel
{
    Customised = false,
    RecipientType = Model.Email.RecipientType
})

<form method="post">
    @Html.AntiForgeryToken()

    <div class="form-check mb-3">
        @Html.CheckBox("overridable", Model.Email.Overridable, new { @class = "form-check-input" })
        <label class="form-check-label" for="overridable">
            Overridable
        </label>
    </div>

    @await Html.PartialAsync("SiteAdmin/_EmailForm", new SiteEmailFormViewModel
    {
        Content = Model.Email.HtmlContent,
        // The layout is a whole HTML document rather than a fragment, so its editor grows to fit it all.
        MaxEditorLines = Model.Email.Type == EmailType.Layout
            ? null
            : SiteEmailFormViewModel.DefaultMaxEditorLines,
        Placeholders = EmailTemplateParameters.ForSite(Model.Email.Type),
        Subject = Model.Email.Subject,
        ValidateUrl = $"/siteadmin/emails/{Model.Email.Type}/validate"
    })
    <div class="button-container">
        <button class="btn btn-primary me-auto">Update</button>
        <button class="btn btn-secondary" type="button"
                data-submit="#send-test-form"
                data-bs-toggle="tooltip" data-bs-title="Send a test email to yourself">
            @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.Envelope))
            <span>Send test</span>
        </button>
    </div>
</form>

<form method="post" action="/siteadmin/emails/@Model.Email.Type/send/test"
      id="send-test-form">
    @Html.AntiForgeryToken()
</form>

<div class="mt-3">
    <h3 class="content-heading">Placeholders</h3>
    @await Html.PartialAsync("Admin/Chapter/_EmailParameters", Model.Parameters)
</div>