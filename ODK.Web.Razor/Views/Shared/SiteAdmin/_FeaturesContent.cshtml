@using ODK.Core.Utils
@using ODK.Services.Features
@using ODK.Web.Common.Routes
@using ODK.Web.Common.Services
@using ODK.Web.Razor.Models.Components
@inject IFeatureService FeatureService
@inject IOdkRoutes OdkRoutes
@inject IRequestStore RequestStore
@{
    var request = RequestStore.MemberServiceRequest;
    var features = await FeatureService.GetFeatures(request);

    var options = new FriendlyDateStringOptions
    {
        ForceIncludeYear = true,
        TimeZone = request.CurrentMember.TimeZone
    };
}

<h2 class="content-heading">Feature notifications</h2>

<p>
    <a class="btn btn-primary" href="@OdkRoutes.SiteAdmin.FeatureCreate">
        @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.Plus))
        <span>Create</span>
    </a>
</p>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Name</th>
            <th>Added</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var feature in features)
        {
            <tr>
                <td>
                    <a href="@OdkRoutes.SiteAdmin.Feature(feature.Id)">@feature.Name</a>
                </td>
                <td>@feature.CreatedUtc.ToFriendlyDateString(options)</td>
                <td>
                    <form action="/siteadmin/features/@feature.Id/delete" method="post">
                        @Html.AntiForgeryToken()
                        @await Html.PartialAsync("Components/_Confirm", new ConfirmViewModel
                        {
                            Message = $"Are you sure you want to delete the '{feature.Name}' feature?",
                            Title = "Delete feature"
                        })
                        <button class="btn-icon text-danger">
                            @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.Times))
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>