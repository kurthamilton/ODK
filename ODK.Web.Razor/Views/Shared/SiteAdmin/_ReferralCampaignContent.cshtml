@using ODK.Core.Utils
@using ODK.Services.Referrals.ViewModels
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Models.SiteAdmin
@model ReferralCampaignAdminPageViewModel
@{
    var campaign = Model.Campaign;

    var options = new FriendlyDateStringOptions { TimeZone = Model.TimeZone };
}

<div class="section-stack">
    <form method="post">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("SiteAdmin/_ReferralCampaignForm", new ReferralCampaignFormViewModel
        {
            // Stored as the instant the expiry day ends, so step back to the day the admin chose.
            DescriptionHtml = campaign.DescriptionHtml,
            EmailSubject = campaign.EmailSubject,
            EmailTextHtml = campaign.EmailTextHtml,
            ExpiresLocalDate = campaign.ExpiresUtc?.AddDays(-1).Date,
            Name = campaign.Name
        })
        <button class="btn btn-primary">Update</button>
    </form>

    @await Html.PartialAsync("Components/_Section", new SectionViewModel
    {
        Heading = new HeadingViewModel
        {
            Title = "Referrals",
            Type = HeadingType.H3
        },
        BodyContentFunc =
            @<div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Created</th>
                            <th>Member</th>
                            <th>Email address</th>
                            <th>Completed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Referrals.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-muted">No referrals have been sent for this campaign.</td>
                            </tr>
                        }
                        @foreach (var dto in Model.Referrals)
                        {
                            <tr>
                                <td>@dto.Referral.CreatedUtc.ToFriendlyDateTimeString(options)</td>
                                <td>@dto.Member.FullName</td>
                                <td>@dto.Referral.EmailAddress</td>
                                <td>
                                    @if (dto.Referral.CompletedUtc != null)
                                    {
                                        @dto.Referral.CompletedUtc.Value.ToFriendlyDateTimeString(options)
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
    })
</div>
