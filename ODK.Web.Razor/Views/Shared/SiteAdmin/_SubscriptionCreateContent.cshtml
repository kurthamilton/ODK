@using ODK.Services.Subscriptions
@using ODK.Web.Common.Services
@using ODK.Web.Razor.Models.SiteAdmin
@inject IRequestStore RequestStore
@inject ISiteSubscriptionAdminService SiteSubscriptionAdminService
@{
    var request = RequestStore.MemberServiceRequest;
    var viewModel = await SiteSubscriptionAdminService.GetSubscriptionCreateViewModel(request);

    var defaultSitePaymentSettingsId = viewModel.SitePaymentSettings
        .Where(x => x.Active && x.Platform == request.Platform)
        .FirstOrDefault()
        ?.Id;
}

<h2 class="content-heading">Create subscription</h2>

<section class="section">
    <form action="/siteadmin/subscriptions" method="post">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("SiteAdmin/_SiteAdminSubscriptionForm", new SiteSubscriptionFormViewModel
        {
            SitePaymentSettingId = defaultSitePaymentSettingsId,
            SitePaymentSettings = viewModel.SitePaymentSettings,
            SiteSubscriptionId = null,
            SiteSubscriptions = viewModel.Subscriptions
        })
        <button class="btn btn-primary">Create</button>
    </form>
</section>