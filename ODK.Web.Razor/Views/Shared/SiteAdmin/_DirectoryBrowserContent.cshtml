@using ODK.Services.Geolocation
@using ODK.Web.Common.Routes
@using ODK.Web.Common.Services
@model string
@inject IIpLocationDatabaseService IpLocationDatabaseService
@inject IOdkRoutes OdkRoutes
@inject IRequestStore RequestStore
@{
    var viewModel = await IpLocationDatabaseService.GetDirectory(RequestStore.MemberServiceRequest, Model);

    string BrowseUrl(string path) => $"{OdkRoutes.SiteAdmin.Geolocation.Path}?path={Uri.EscapeDataString(path)}";
}

<h3>Directory browser</h3>

<p>
    Read-only, for working out what the application can see. It runs as
    <code>@viewModel.Identity</code>, which is the account a folder's permissions have to grant.
</p>

<dl class="row">
    <dt class="col-sm-2">Path</dt>
    <dd class="col-sm-10"><code>@viewModel.Path</code></dd>
    <dt class="col-sm-2">Exists</dt>
    <dd class="col-sm-10">
        @if (viewModel.Exists)
        {
            <span class="badge text-bg-success">Yes</span>
        }
        else
        {
            <span class="badge text-bg-danger">No</span>
        }
    </dd>
</dl>

@if (!string.IsNullOrEmpty(viewModel.Error))
{
    <div class="alert alert-danger">
        <strong>Could not read this directory:</strong> @viewModel.Error
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-3">
    @if (!string.IsNullOrEmpty(viewModel.ParentPath))
    {
        <a class="btn btn-sm btn-secondary" href="@BrowseUrl(viewModel.ParentPath)">Up one level</a>
    }
    <a class="btn btn-sm btn-secondary" href="@OdkRoutes.SiteAdmin.Geolocation.Path">Configured directory</a>
    <form method="post" action="@OdkRoutes.SiteAdmin.GeolocationWriteTest.Path">
        @Html.AntiForgeryToken()
        <input type="hidden" name="path" value="@viewModel.Path" />
        <button class="btn btn-sm btn-outline-primary">Test write here</button>
    </form>
</div>

@if (viewModel.Exists)
{
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Size</th>
                    <th>Modified (UTC)</th>
                </tr>
            </thead>
            <tbody>
                @if (viewModel.Entries.Count == 0)
                {
                    <tr>
                        <td colspan="3">Empty, or nothing here is readable.</td>
                    </tr>
                }
                @foreach (var entry in viewModel.Entries)
                {
                    <tr>
                        <td>
                            @if (entry.IsDirectory)
                            {
                                <a href="@BrowseUrl(entry.Path)">@entry.Name/</a>
                            }
                            else
                            {
                                @entry.Name
                            }
                        </td>
                        <td>@(entry.SizeBytes != null ? $"{entry.SizeBytes:n0} bytes" : "-")</td>
                        <td>@(entry.LastModifiedUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
