@using ODK.Core.Utils
@using ODK.Services.Emails
@using ODK.Web.Common.Routes
@using ODK.Web.Common.Services
@using ODK.Web.Razor.Models.Components
@inject IEmailAdminService EmailAdminService
@inject IOdkRoutes OdkRoutes
@inject IRequestStore RequestStore
@{
    var emails = await EmailAdminService.GetEmails(RequestStore.MemberServiceRequest);
}

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Email</th>
                <th>Recipients</th>
                <th>Overridable</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var email in emails.OrderBy(x => x.Name))
            {
                <tr>
                    <td>
                        <a href="@OdkRoutes.SiteAdmin.Email(email.Type)">
                            @email.Name
                        </a>
                    </td>
                    <td>
                        @EnumUtils.GetDisplayValue(email.RecipientType)
                    </td>
                    <td>
                        @if (email.Overridable)
                        {
                            <span>
                                @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.CheckCircle)
                                {
                                    Class = "text-success"
                                })
                            </span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
