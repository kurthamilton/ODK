@using ODK.Web.Razor.Models.Admin.Emails
@using ODK.Web.Razor.Models.SiteAdmin
@using ODK.Web.Razor.Mvc
@model SiteEmailFormViewModel

<div class="form-group mb-3 required">
    @Html.LabelFor(x => x.Subject, new { @class = "form-label" })
    @Html.OdkEmailTemplateBoxFor(x => x.Subject, Model.Placeholders,
        htmlAttributes: new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.Subject)
</div>

<div class="form-group mb-3 required">
    @* Label and toolbar share a row, laid out here rather than by the toolbar. Nothing below it: the site's
       own fields are always editable, so there is no Customise switch to sit under the label. *@
    <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
        @Html.LabelFor(x => x.ContentHtml, new { @class = "form-label mb-0 me-auto" })

        @await Html.PartialAsync("Emails/_EmailEditorButtons", new EmailEditorButtonsViewModel
        {
            PreviewUrl = Model.PreviewUrl
        })
    </div>

    @* Always insertable: the site's own template is written by a site admin, who may use every placeholder. *@
    @await Html.PartialAsync("Emails/_EmailPlaceholders", new EmailPlaceholdersViewModel
    {
        CanInsert = true,
        Placeholders = Model.Placeholders
    })

    @* rows is the editor's minimum height and max-lines its maximum - see odk.code-editor.js. *@
    @Html.OdkEmailTemplateTextAreaFor(x => x.ContentHtml, Model.Placeholders, Model.ValidateUrl,
        htmlAttributes: new
        {
            @class = "form-control",
            rows = 5,
            id = EmailEditorElements.FieldId,
            data_code_editor_max_lines = Model.MaxEditorLines?.ToString() ?? "none"
        })

    @Html.ValidationMessageFor(x => x.ContentHtml)
</div>
