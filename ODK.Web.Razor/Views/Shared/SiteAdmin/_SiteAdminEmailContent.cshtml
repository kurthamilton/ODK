@using ODK.Core.Emails
@using ODK.Services.Emails.Parameters
@using ODK.Web.Razor.Models.Admin.Emails
@using ODK.Web.Razor.Models.SiteAdmin
@model EmailContentViewModel

@* No Custom badge: this is the template a group's customisation would be of. *@
@await Html.PartialAsync("Emails/_EmailBadges", new EmailBadgesViewModel
{
    Customised = false,
    RecipientType = Model.Email.RecipientType
})

<form method="post">
    @Html.AntiForgeryToken()

    <div class="form-check mb-3">
        @Html.CheckBox("isGroupEmail", Model.Email.IsGroupEmail, new { @class = "form-check-input" })
        <label class="form-check-label" for="isGroupEmail">
            Group email
        </label>
    </div>

    @await Html.PartialAsync("SiteAdmin/_SiteAdminEmailForm", new SiteEmailFormViewModel
    {
        Content = Model.Email.HtmlContent,
        // The layout is a whole HTML document rather than a fragment, so its editor grows to fit it all.
        MaxEditorLines = Model.Email.Type == EmailType.Layout
            ? null
            : SiteEmailFormViewModel.DefaultMaxEditorLines,
        Placeholders = EmailTemplateParameters.ForSite(Model.Email.Type),
        PreviewUrl = $"/siteadmin/emails/{Model.Email.Type}/preview",
        Subject = Model.Email.Subject,
        ValidateUrl = $"/siteadmin/emails/{Model.Email.Type}/validate"
    })
    <div class="button-container">
        <button class="btn btn-primary">Update</button>
    </div>
</form>

@* Empty but for its token: the toolbar's test button submits it, and it cannot be nested inside the form
   above. *@
<form method="post" action="/siteadmin/emails/@Model.Email.Type/send/test"
      id="@EmailEditorElements.SendTestFormId">
    @Html.AntiForgeryToken()
</form>

<div class="mt-5">
    <h3 class="content-heading">Placeholders</h3>
    @await Html.PartialAsync("Emails/_EmailParameters", Model.Parameters)
</div>

@await Html.PartialAsync("Emails/_EmailPreviewModal")