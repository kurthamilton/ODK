@model IReadOnlyDictionary<string, string>
@* Metadata exactly as the payment provider holds it, for comparing against a dashboard by eye. Sorted by
   key so two of these side by side line up. *@

<div data-odk-component="_SiteAdminStripeMetadata">
    @if (Model.Count == 0)
    {
        <span class="text-muted">None</span>
    }
    else
    {
        <dl class="mb-0 small">
            @foreach (var entry in Model.OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase))
            {
                <dt class="fw-normal text-muted">@entry.Key</dt>
                <dd class="mb-1 text-break"><code>@entry.Value</code></dd>
            }
        </dl>
    }
</div>
