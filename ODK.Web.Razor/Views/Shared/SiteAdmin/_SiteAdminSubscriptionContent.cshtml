@using ODK.Services.Subscriptions.ViewModels
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Models.SiteAdmin
@model SiteSubscriptionEditViewModel
@{
    var currencyDictionary = Model.Currencies.ToDictionary(x => x.Currency.Id);
}

<div class="section-stack">
    <form action="/siteadmin/Subscriptions/@Model.Subscription.Id" method="post">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("SiteAdmin/_SiteAdminSubscriptionForm", new SiteSubscriptionFormViewModel
        {
            DescriptionHtml = Model.Subscription.DescriptionHtml,
            Enabled = Model.Subscription.Enabled,
            FallbackSiteSubscriptionId = Model.Subscription.FallbackSiteSubscriptionId,
            Features = Model.Features.Select(x => x.Feature).ToList(),
            Free = Model.Subscription.Free,
            GroupLimit = Model.Subscription.GroupLimit,
            MemberLimit = Model.Subscription.MemberLimit,
            Name = Model.Subscription.Name,
            SiteSubscriptionId = Model.Subscription.Id,
            SiteSubscriptions = Model.Subscriptions
        })
        <button class="btn btn-primary">Update</button>
    </form>

    @await Html.PartialAsync("Components/_Section", new SectionViewModel
    {
        Heading = new HeadingViewModel
        {
            Title = "Prices",
            Type = HeadingType.H3
        },
        BodyContentFunc =
            @<div>
                @if (Model.Subscription.Free)
                {
                    <p>
                        This subscription is free, so it needs no price. Any price listed below predates that
                        and is ignored - delete it when convenient.
                    </p>
                }
                <div class="table-responsive">
                    <table class="table table--striped">
                        <thead>
                            <tr>
                                <th>Currency</th>
                                <th>Frequency</th>
                                <th>Amount</th>
                                <th>External Id</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var price in Model.Prices.OrderBy(x => x.Amount))
                            {
                                var currency = currencyDictionary[price.CurrencyId];

                                <tr>
                                    <td>@await Html.PartialAsync("Components/_Currency", currency)</td>
                                    <td>@price.Frequency.ToString()</td>
                                    <td>@currency.Currency.ToAmountString(price.Amount)</td>
                                    <td>@price.ExternalId</td>
                                    <td>
                                        @if (price.CanDelete)
                                        {
                                            <form action="/siteadmin/Subscriptions/@Model.Subscription.Id/Prices/@price.Id/Delete" method="post">
                                                @Html.AntiForgeryToken()
                                                @await Html.PartialAsync("Components/_Confirm", new ConfirmViewModel
                                                {
                                                    Message = "Are you sure you want to delete this price?",
                                                    Title = "Delete price"
                                                })
                                                <button data-bs-toggle="tooltip" data-bs-title="Delete" class="btn-icon text-danger">
                                                    @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.Times))
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!Model.Subscription.Free)
                {
                    <div class="mt-3">
                        <form action="/siteadmin/Subscriptions/@Model.Subscription.Id/Prices" method="post">
                            @Html.AntiForgeryToken()

                            <div class="form-inline-md">
                                @await Html.PartialAsync("SiteAdmin/_SubscriptionPriceForm", new SiteSubscriptionPriceFormViewModel
                                {
                                    CurrencyOptions = Model.Currencies.ToList()
                                })

                                <div class="form-group">
                                    <button class="btn btn-primary">Add</button>
                                </div>
                            </div>
                        </form>
                    </div>
                }
            </div>
    })
</div>
