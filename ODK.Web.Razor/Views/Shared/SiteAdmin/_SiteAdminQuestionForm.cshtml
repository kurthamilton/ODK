@using ODK.Services.Questions
@using ODK.Web.Razor.Models.SiteAdmin
@model SiteQuestionFormViewModel

@* "Placeholder" rather than the parameter the code calls it, matching the word the email templates already
   use for the same thing. *@
<p class="text-muted">
    Write <code>{@SiteQuestionParameters.PlatformName}</code> in either field and it is replaced with this
    platform's name, so one question reads correctly wherever it is shown.
</p>

<div class="form-group mb-3 required">
    @Html.LabelFor(x => x.Question, new { @class = "form-label" })
    @Html.TextBoxFor(x => x.Question, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.Question)
</div>

<div class="form-group mb-3 required">
    @Html.LabelFor(x => x.AnswerHtml, new { @class = "form-label" })
    @Html.TextAreaFor(x => x.AnswerHtml, new { @class = "form-control", rows = 5, data_html_editor = "" })
    @Html.ValidationMessageFor(x => x.AnswerHtml)
</div>
