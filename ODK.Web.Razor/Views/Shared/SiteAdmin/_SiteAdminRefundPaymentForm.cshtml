@using ODK.Web.Razor.Models.SiteAdmin
@model RefundPaymentFormViewModel
@{
    /* A page of payments renders one of these per row, so the field ids are qualified by the payment. The
       posted names are untouched - each form posts on its own - but a label pointing at a bare "Amount"
       would name whichever row rendered first. */
    var amountId = $"refund-amount-{Model.PaymentId}";
    var reasonId = $"refund-reason-{Model.PaymentId}";
}

<form method="post" action="/siteadmin/payments/@Model.PaymentId/refund"
      data-odk-component="_SiteAdminRefundPaymentForm">
    @Html.AntiForgeryToken()

    <div class="form-group mb-3 required">
        @Html.LabelFor(x => x.Amount, new { @class = "form-label", @for = amountId })
        @await Html.PartialAsync("Components/_FormLabelSubtitle",
            "What to give the member back. Less than the whole leaves the rest refundable later.")
        <div class="input-group">
            <span class="input-group-text">
                @Model.Currency.Symbol
            </span>
            @Html.TextBoxFor(x => x.Amount, format: "{0:0.00}", new
            {
                @class = "form-control",
                id = amountId,
                type = "number",
                min = 0.01,
                max = Model.RefundableAmount,
                step = 0.01,
                required = "required"
            })
        </div>
        @Html.ValidationMessageFor(x => x.Amount)
    </div>

    <div class="form-group mb-3 required">
        @Html.LabelFor(x => x.Reason, new { @class = "form-label", @for = reasonId })
        @await Html.PartialAsync("Components/_FormLabelSubtitle",
            "The whole of the audit trail for money leaving a group's account, so worth a sentence rather than a word.")
        @Html.TextAreaFor(x => x.Reason, new
        {
            @class = "form-control",
            id = reasonId,
            rows = 3,
            required = "required"
        })
        @Html.ValidationMessageFor(x => x.Reason)
    </div>

    <div class="alert alert-warning">
        This refunds the member through the payment provider now, and takes what it can back off the
        group's transfer. Neither can be undone from here.
    </div>

    <div class="button-container">
        <button type="submit" class="btn btn-danger">Refund</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>
