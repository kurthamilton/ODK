@using ODK.Core.Emails
@using ODK.Core.Utils
@using ODK.Services.Emails
@using ODK.Web.Common.Routes
@using ODK.Web.Common.Services
@using ODK.Web.Razor.Models.Components
@inject IEmailAdminService EmailAdminService
@inject IOdkRoutes OdkRoutes
@inject IRequestStore RequestStore
@{
    var emails = await EmailAdminService.GetSiteEmails(RequestStore.MemberServiceRequest);

    (string Heading, string Description, IEnumerable<Email> Emails)[] tables =
    [
        ("Site email templates", "Sent by the site itself, and only a site admin edits them.",
            emails.Where(x => !x.IsGroupEmail)),
        ("Group email templates", "Sent by a group, so a group admin can customise the wording.",
            emails.Where(x => x.IsGroupEmail))
    ];
}

<div class="section-stack">
    @foreach (var table in tables)
    {
        @await Html.PartialAsync("Components/_Section", new SectionViewModel
        {
            Heading = new HeadingViewModel
            {
                Title = table.Heading,
                Type = HeadingType.H3
            },
            BodyContentFunc =
                @<div>
                    <p class="text-muted">@table.Description</p>
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Email</th>
                                    <th>Recipients</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var email in table.Emails.OrderBy(x => x.Name))
                                {
                                    <tr>
                                        <td>
                                            <a href="@OdkRoutes.SiteAdmin.Email(email.Type)">
                                                @email.Name
                                            </a>
                                        </td>
                                        <td>
                                            @EnumUtils.GetDisplayValue(email.RecipientType)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
        })
    }
</div>
