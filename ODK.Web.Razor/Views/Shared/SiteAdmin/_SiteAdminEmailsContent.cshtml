@using ODK.Services.Platforms
@using ODK.Services.Settings
@using ODK.Web.Common.Services
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Models.SiteAdmin
@inject IPlatformProvider PlatformProvider
@inject IRequestStore RequestStore
@inject ISettingsService SettingsService
@{
    var request = RequestStore.MemberServiceRequest;
    var settings = await SettingsService.GetSiteEmailSettings(request);
    var platformName = PlatformProvider.GetName(request.Platform);
}

<div class="section-stack">
    @await Html.PartialAsync("Components/_Section", new SectionViewModel
    {
        Heading = new HeadingViewModel
        {
            Title = "Email settings",
            Type = HeadingType.H3
        },
        BodyContentFunc =
            @<div>
                <p class="text-muted">
                    These apply to <strong>@platformName</strong> only. Each platform has its own settings,
                    chosen by the address the site is reached on, so editing here leaves the other platform
                    alone.
                </p>
                <form action="/siteadmin/emails/settings" method="post">
                    @Html.AntiForgeryToken()
                    @await Html.PartialAsync("SiteAdmin/_SiteAdminEmailSettingsForm", new SiteEmailSettingsViewModel
                    {
                        AdminTitle = settings.AdminTitle,
                        FromEmailAddress = settings.FromEmailAddress,
                        MemberTitle = settings.MemberTitle
                    })
                    <button class="btn btn-primary" type="submit">Update</button>
                </form>
            </div>
    })

    @await Html.PartialAsync("SiteAdmin/_SiteAdminEmailsTables")
</div>
