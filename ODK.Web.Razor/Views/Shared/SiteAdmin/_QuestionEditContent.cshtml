@using ODK.Services.Questions
@using ODK.Web.Common.Routes
@using ODK.Web.Common.Services
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Models.SiteAdmin
@model Guid
@inject IOdkRoutes OdkRoutes
@inject ISiteQuestionAdminService SiteQuestionAdminService
@inject IRequestStore RequestStore
@{
    var viewModel = await SiteQuestionAdminService.GetQuestionViewModel(RequestStore.MemberServiceRequest, Model);
    var question = viewModel.Question;

    var formViewModel = new SiteQuestionFormViewModel
    {
        Answer = question.Answer,
        Question = question.Name
    };
}

<h2 class="content-heading">@question.Name</h2>

<form method="post" action="/siteadmin/questions/@question.Id">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("SiteAdmin/_QuestionForm", formViewModel)

    <div class="d-flex justify-content-between">
        <button type="submit" class="btn btn-primary">Save</button>

        <a class="btn btn-secondary" href="@OdkRoutes.SiteAdmin.Questions.Path">
            @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.AngleLeft))
            <span>Back</span>
        </a>
    </div>
</form>
