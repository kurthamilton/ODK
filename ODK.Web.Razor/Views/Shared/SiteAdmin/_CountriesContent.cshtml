@using ODK.Services.Countries
@using ODK.Web.Common.Routes
@using ODK.Web.Common.Services
@inject ICountryAdminService CountryAdminService
@inject IOdkRoutes OdkRoutes
@inject IRequestStore RequestStore
@{
    var countries = (await CountryAdminService.GetCountries(RequestStore.MemberServiceRequest))
        .OrderBy(x => x.Name)
        .ToArray();
}

<h2 class="content-heading">Countries</h2>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Name</th>
            <th>ISO</th>
            <th>Continent</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var country in countries)
        {
            <tr>
                <td>
                    <a href="@OdkRoutes.SiteAdmin.Country(country.Id)">@country.Name</a>
                </td>
                <td>@country.IsoCode2</td>
                <td>@country.Continent</td>
            </tr>
        }
        </tbody>
    </table>
</div>
