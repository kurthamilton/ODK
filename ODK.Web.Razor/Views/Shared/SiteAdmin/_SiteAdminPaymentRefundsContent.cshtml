@using System.Globalization
@using ODK.Core.Utils
@using ODK.Services.Payments.ViewModels
@using ODK.Web.Razor.Models.Components
@model PaymentRefundsViewModel
@{
    var dateTimeOptions = new FriendlyDateStringOptions
    {
        ForceIncludeYear = true,
        TimeZone = Model.TimeZone
    };
}

<div data-odk-component="_SiteAdminPaymentRefundsContent">
    <h2 class="content-heading">Refunds</h2>

    <p>
        Every refund made through the payment provider, what came back off the group to cover it, and what
        the group is left owing. Refunds are raised from a group's payments page.
    </p>

    <div class="table-responsive">
        <table class="table" data-sortable data-table-striped>
            <thead>
                <tr>
                    <th data-sortable-sort="default" data-sortable-dir="desc">Refunded</th>
                    @* The payment's own date, so a row can be matched to the charge it undoes. *@
                    <th data-sortable-sort>Paid</th>
                    <th data-sortable-sort>Group</th>
                    <th>Reference</th>
                    <th>Refunded</th>
                    <th>Reversed</th>
                    <th>Group owes</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Refunds.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-muted">No refunds recorded.</td>
                    </tr>
                }

                @foreach (var item in Model.Refunds)
                {
                    var (payment, refund) = (item.Payment, item.Refund);

                    <tr>
                        <td>
                            <span class="d-none" data-sort-value="@refund.RefundedUtc?.ToString("O", CultureInfo.InvariantCulture)"></span>
                            @(refund.RefundedUtc?.ToFriendlyDateTimeString(dateTimeOptions) ?? "-")
                        </td>
                        <td>
                            <span class="d-none" data-sort-value="@payment.PaidUtc?.ToString("O", CultureInfo.InvariantCulture)"></span>
                            @(payment.PaidUtc?.ToFriendlyDateTimeString(dateTimeOptions) ?? "-")
                        </td>
                        @* A site payment belongs to no group, which is not a gap in the data. *@
                        <td>@(item.ChapterName ?? "-")</td>
                        <td>@payment.Reference</td>
                        <td>@payment.Currency.ToAmountString(refund.Amount)</td>
                        <td>
                            @(item.ReversedAmount != null
                                ? payment.Currency.ToAmountString(item.ReversedAmount.Value)
                                : "-")
                        </td>
                        <td>
                            @* Nothing owed and nothing ever owed are different states, and a bare zero
                               would not tell them apart - so a settled debt says it was collected. *@
                            @if (item.OutstandingAmount == null)
                            {
                                <span>-</span>
                            }
                            else if (item.OutstandingAmount > 0)
                            {
                                <span class="text-danger">
                                    @payment.Currency.ToAmountString(item.OutstandingAmount.Value)
                                </span>
                            }
                            else
                            {
                                <span class="text-success">
                                    @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.Check))
                                    <span>Recovered</span>
                                </span>
                            }
                        </td>
                        <td>@refund.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
