@using ODK.Core.Payments
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Components
@model IReadOnlyCollection<SitePaymentSettings>
@inject IOdkRoutes OdkRoutes

<div data-odk-component="_SiteAdminPaymentsContent">
    <h2 class="content-heading d-none d-md-block">Payment settings</h2>

    <div>
        <p>
            <a class="btn btn-primary" href="@OdkRoutes.SiteAdmin.PaymentCreate">
                @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.Plus))
                <span>Create</span>
            </a>
        </p>
        @* Site-admin only, and safe to run more than once: a payment whose settlement is already
           recorded is skipped, and the transfer of a share already paid is guarded separately. *@
        <form method="post" action="/siteadmin/payments/reconcile" class="mb-3">
            @Html.AntiForgeryToken()
            <button class="btn btn-secondary">Reconcile payment settlements</button>
        </form>

        <div class="table-responsive">
            <table class="table table-striped" data-sortable>
                <thead>
                    <tr>
                        <th data-sortable-sort="default">Name</th>
                        <th>Provider</th>
                        <th>Environment</th>
                        <th>External Id</th>
                        <th>Enabled</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var paymentSetting in Model)
                    {
                        <tr>
                            <td>
                                @* Sorting falls back to the cell's HTML, which would put the link's href
                                   ahead of the text, so the name is stated for it explicitly. *@
                                <span class="d-none" data-sort-value="@paymentSetting.Name"></span>
                                <a href="@OdkRoutes.SiteAdmin.Payment(paymentSetting.Id)">@paymentSetting.Name</a>
                            </td>
                            <td>@paymentSetting.Provider</td>
                            <td>@paymentSetting.Environment</td>
                            <td>
                                @* Sorting falls back to the cell's HTML, which would put a link's href ahead
                                   of the id, so the id is stated for it explicitly. *@
                                <span class="d-none" data-sort-value="@paymentSetting.ExternalId"></span>
                                @if (!string.IsNullOrEmpty(paymentSetting.ExternalId) &&
                                    !string.IsNullOrEmpty(paymentSetting.ExternalUrl))
                                {
                                    <a href="@paymentSetting.ExternalUrl" target="_blank">@paymentSetting.ExternalId</a>
                                }
                                else
                                {
                                    @paymentSetting.ExternalId
                                }
                            </td>
                            <td>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" disabled
                                           checked="@(paymentSetting.Enabled ? "" : null)" />
                                </div>
                            </td>
                            <td>
                                @if (paymentSetting.Active)
                                {
                                    @:Active
                                }
                                else if (paymentSetting.Enabled)
                                {
                                    @* Only an enabled row is offered: activating a disabled one would put
                                       the platform on settings nothing can be bought through. *@
                                    <form action="/siteadmin/payments/@paymentSetting.Id/activate" method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-primary">Activate</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>