@using ODK.Web.Razor.Models.SiteAdmin
@model SiteEmailSettingsViewModel

<div class="row mb-3 gy-3">
    <div class="form-group col-md-6 required">
        @Html.LabelFor(x => x.FromEmailAddress)
        @Html.TextBoxFor(x => x.FromEmailAddress, new { @class = "form-control", type = "email" })
        @Html.ValidationMessageFor(x => x.FromEmailAddress)
    </div>

    <div class="form-group col-md-6 required">
        @Html.LabelFor(x => x.FromEmailName)
        @Html.TextBoxFor(x => x.FromEmailName, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.FromEmailName)
    </div>
</div>

@* All three are templates over an email's other parameters, which is why they sit together. A template
   writes {title}, and which of these it resolves to follows who the email is written for: the member
   title, the admin title, or Title where the email is written for neither. A group can set its own
   member and admin titles; Title is the site's alone. *@
<div class="form-group mb-3">
    @Html.LabelFor(x => x.Title)
    @Html.TextBoxFor(x => x.Title, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.Title)
</div>

<div class="row mb-3 gy-3">
    <div class="form-group col-md-6 required">
        @Html.LabelFor(x => x.MemberTitle)
        @Html.TextBoxFor(x => x.MemberTitle, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.MemberTitle)
    </div>

    <div class="form-group col-md-6 required">
        @Html.LabelFor(x => x.AdminTitle)
        @Html.TextBoxFor(x => x.AdminTitle, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.AdminTitle)
    </div>
</div>

<div class="form-group mb-3">
    @Html.LabelFor(x => x.PlatformTitle)
    @Html.TextBoxFor(x => x.PlatformTitle, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.PlatformTitle)
</div>