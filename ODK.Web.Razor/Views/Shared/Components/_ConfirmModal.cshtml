@using ODK.Web.Razor.Models.Components

@* Shared confirmation dialog - one instance for the whole page. Forms opt in by rendering the _Confirm
    component, which supplies the message and optional title/label/variant (see bindConfirms in odk.js). *@
@await Html.PartialAsync("Components/_Modal", new ModalViewModel
{
    Id = "confirm-modal",
    Size = ModalSize.Small,
    Title = "",
    ForceShowTitle = true,
    Body = @<p class="mb-0" data-odk-confirm-message></p>,
    Footer = 
        @<div class="button-container w-100">
            <button type="button" class="btn btn-secondary me-auto" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-danger" data-odk-confirm-accept>OK</button>
        </div>
})