@using ODK.Web.Razor.Models.Components
@model LocationPickerViewModel
@{
    var latLong = Model.Lat != null && Model.Long != null
        ? $"{Model.Lat},{Model.Long}"
        : null;

    /* The best way to point a map at this location: the Maps Embed API takes a place id directly, and
       coordinates where there is no place - a location recorded before the lookup was the source, which
       would otherwise have a map that never appears. Null only when neither is known. */
    var placeQuery = !string.IsNullOrEmpty(Model.ExternalId)
        ? $"place_id:{Model.ExternalId}"
        : latLong;
}

<div class="input-group" data-location-container>
    <span class="input-group-text">
        <span data-bs-toggle="tooltip" data-bs-title="Location">
            @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.LocationPin))
        </span>       
    </span>

    <div class="dropdown flex-grow-1">
        @Html.TextBoxFor(x => x.LocationName, new
        {
            @class = "form-control",
            data_location = "",
            data_bs_toggle = "dropdown",
            placeholder = Model.Placeholder ?? string.Empty
        })

        <ul class="dropdown-menu google-places-suggestions" data-location-options></ul>
    </div> 
    
    @Html.HiddenFor(x => x.ExternalId, new { data_location_external_id = "" })
    @Html.HiddenFor(x => x.Lat, new { data_location_lat = "" })
    @Html.HiddenFor(x => x.Long, new { data_location_long = "" })
    <input type="hidden" id="map-latlong" data-location-latlong value="@latLong" />
    <input type="hidden" id="map-place-query" data-location-map-query value="@placeQuery" />
</div>
@Html.ValidationMessageFor(x => x.LocationName)