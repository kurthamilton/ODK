@using ODK.Web.Razor.Models.Components
@model BodyWithSidebarViewModel
@{
    var breakpoint = Model.SidebarBreakpoint;
    var sidebarAtStart = Model.SidebarPosition == "start";

    var containerClass = !string.IsNullOrEmpty(Model.ContainerClass)
        ? Model.ContainerClass
        : BodyViewModel.DefaultContainerClass;

    // The content column comes first in the DOM, so order-1 on the sidebar lifts it above while the two
    // are stacked. A sidebar on the end swaps that back from the breakpoint up; one on the start keeps it.
    var contentClass = $"col-xl-9 col-{breakpoint}-8 order-2" + (sidebarAtStart ? null : $" order-{breakpoint}-1");
    var sidebarClass = $"col-xl-3 col-{breakpoint}-4 order-1" + (sidebarAtStart ? null : $" order-{breakpoint}-2");
}

<main id="main" class="@Model.Class">
    @await Html.PartialAsync("Components/_PageTitle", new PageTitleViewModel
    {
        ContainerClass = Model.ContainerClass,
        Content = Model.TitleContent,
        Title = Model.Title,
        WidthClass = Model.WidthClass
    })

    @if (Model.Menu != null)
    {
        @Model.Menu
    }

    @* Positioning context for a corner ribbon (see _preview-label.scss). Full width and starts
       below the title, so an absolutely positioned child lands on the page edge rather than
       inset by the content column. Inert without such a child. *@
    <div class="preview-label-container">
        <div class="@containerClass" data-site-header-class="@containerClass">
            @await Html.PartialAsync("Components/_ToastAnchor", new ToastAnchorViewModel())
            <div class="row @(Model.WidthClass != null ? "justify-content-center" : null)">
                <div class="@(Model.WidthClass ?? "col-12")">                
                    <div class="page-alerts">
                        @if (!Model.HideSubscriptionAlert)
                        {
                            @await Html.PartialAsync("Members/_SubscriptionAlertPlaceholder")
                        }
                    </div>

                    <section class="page-main">
                        @if (Model.Breadcrumbs != null)
                        {
                            @await Html.PartialAsync("Components/_Breadcrumbs", new BreadcrumbsViewModel
                            {
                                Breadcrumbs = Model.Breadcrumbs
                            })
                        }
            
                        <div class="row">
                            <div class="@contentClass">
                                @if (Model.Content != null)
                                {
                                    @Model.Content
                                }

                                @Model.ContentFunc?.Invoke(null)
                            </div>
                            <div class="@sidebarClass">
                                @if (Model.SidebarContent != null)
                                {
                                    @Model.SidebarContent
                                }
                            </div>
                        </div>
                    </section>
                </div>        
            </div>    
    
        </div>
    </div>
</main>
