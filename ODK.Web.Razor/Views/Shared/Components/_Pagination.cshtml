@using ODK.Web.Razor.Models.Components
@model PaginationViewModel

<nav aria-label="@Model.AccessibilityLabel" data-odk-pagination="@Model.PageUrlTemplate">
    @* flex-wrap as well as the windowed page list: the window is bounded, but a narrow enough screen can
       still run out of room, and wrapping keeps it inside the viewport rather than widening the page. *@
    <ul class="pagination flex-wrap">
        <li class="page-item @(Model.Page <= 1 ? "disabled" : null)">
            <a class="page-link" href="@Model.GetPageUrl(Model.Page - 1)"
                data-bs-toggle="tooltip" title="Previous">
                @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.AngleLeft))
            </a>
        </li>
        @foreach (var item in Model.VisiblePages)
        {
            @* A gap stands for a run of pages, so it has no single page to link to - it opens a control for
               picking one instead. A dropdown rather than markup of our own: Popper keeps it inside the
               viewport near the screen edge, which is the failure this component already has history with. *@
            @if (item.IsGap)
            {
                var inputId = $"pagination-goto-{item.From}-{item.To}";

                <li class="page-item dropdown">
                    <button type="button" class="page-link" data-bs-toggle="dropdown"
                            data-bs-auto-close="outside" aria-expanded="false"
                            aria-label="Go to a page between @item.From and @item.To">&hellip;</button>
                    <div class="dropdown-menu p-3" data-odk-pagination-goto>
                        <label class="form-label" for="@inputId">Go to page</label>
                        <div class="input-group flex-nowrap">
                            <input type="number" class="form-control" id="@inputId"
                                   min="@item.From" max="@item.To" value="@item.NearestPage"
                                   data-odk-pagination-page />
                            <button type="button" class="btn btn-outline-secondary"
                                    data-odk-pagination-step="-1" aria-label="Previous page">&minus;</button>
                            <button type="button" class="btn btn-outline-secondary"
                                    data-odk-pagination-step="1" aria-label="Next page">+</button>
                            <button type="button" class="btn btn-primary" data-odk-pagination-go>Go</button>
                        </div>
                    </div>
                </li>
            }
            else
            {
                <li class="page-item @(item.PageNumber == Model.Page ? "active" : null)">
                    <a class="page-link" href="@Model.GetPageUrl(item.PageNumber!.Value)">@(item.PageNumber)</a>
                </li>
            }
        }
        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)">
            <a class="page-link" href="@Model.GetPageUrl(Model.Page + 1)"
               data-bs-toggle="tooltip" title="Next">
                @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.AngleRight))
            </a>
        </li>
    </ul>
</nav>
