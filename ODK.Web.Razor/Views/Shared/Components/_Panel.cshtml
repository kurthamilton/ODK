@using ODK.Web.Razor.Models.Components
@model PanelViewModel
@{
    var heading = Model.Heading ?? (!string.IsNullOrEmpty(Model.Title)
        ? new HeadingViewModel { Title = Model.Title }
        : null);
}

<section class="panel @Model.Class" data-odk-component="_Panel">
    <div class="panel-header">

        @if (Model.TitleContentFunc != null)
        {
            <div class="panel-title">
                @Model.TitleContentFunc.Invoke(null)
            </div>
        }
        else if (heading != null)
        {
            <div class="panel-title">
                @await Html.PartialAsync("Components/_Heading", heading)
            </div>
        }

        @if (Model.TitleEndContentFunc != null)
        {
            <div class="panel-title-end">
                @Model.TitleEndContentFunc.Invoke(null)
            </div>
        }
    </div>    
    <div class="panel-body">
        @if (Model.BodyContentFunc != null)
        {
            @Model.BodyContentFunc.Invoke(null)
        }        

        @if (Model.BodyContent != null)
        {
            @Model.BodyContent
        }
    </div>    
</section>