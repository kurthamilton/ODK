@using ODK.Web.Razor.Models.Components
@model SectionViewModel

<section class="section @Model.Class" id="@Model.Id" data-odk-component="_Section">
    @if (Model.Heading != null || Model.TitleEndContentFunc != null)
    {
        <div class="section-header">
            @if (Model.Heading != null)
            {                
                @await Html.PartialAsync("Components/_Heading", Model.Heading)
            }

            @if (Model.TitleEndContentFunc != null)
            {
                <div class="section-title-end">
                    @Model.TitleEndContentFunc.Invoke(null)
                </div>
            }
        </div>        
    }

    @if (Model.BodyContentFunc != null)
    {
        @Model.BodyContentFunc.Invoke(null)
    }

    @if (Model.BodyContent != null)
    {
        @Model.BodyContent
    }
</section>
