@using ODK.Core.Web
@using ODK.Web.Common.Settings
@using ODK.Web.Razor.Models.Components
@model GoogleMapViewModel
@inject GoogleMapViewSettings Settings
@{
    var query = Model.GoogleMapsQuery();

    if (string.IsNullOrEmpty(query) && 
        string.IsNullOrEmpty(Model.QuerySource))
    {
        return;
    }

    var urlBuilder = UrlBuilder.Base("https://www.google.com/maps/embed/v1/place")
        .Query("key", Settings.ApiKey);

    if (!string.IsNullOrEmpty(query))
    {
        urlBuilder.Query("q", query);
    }

    if (Model.Zoom >= 0)
    {
        urlBuilder.Query("zoom", Model.Zoom.Value.ToString());
    }

    var url = urlBuilder.Build();
}

<iframe height="450" frameborder="0" style="border:0; width: 100%;"
        src="@url"
        data-map-baseurl="@url"
        data-map-query="@Model.QuerySource"
        allowfullscreen>
</iframe>

@if (Model.ShowLink)
{
    <p>
        <a href="https://google.com/maps?q=@query" target="_blank">View in Google maps</a>
    </p>
}

<script src="~/js/odk.maps.js" asp-append-version="true"></script>