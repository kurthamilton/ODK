@using ODK.Web.Razor.Models.Components
@model BandViewModel
@{
    // A grey band declares no theme: it paints its own background, and a theme here would have Bootstrap
    // paint the components inside it for a white one. It pins the light theme's text colour in
    // _bands.scss instead. Razor omits an attribute whose value is null.
    var bsTheme = Model.Theme switch
    {
        BandThemeType.Dark => "dark",
        BandThemeType.Grey => null,
        _ => "light"
    };

    var classes = new List<string>
    {
        "band"
    };

    if (Model.Hero)
    {
        classes.Add("band--hero");
    }

    if (Model.Theme == BandThemeType.Grey)
    {
        classes.Add("band--grey");
    }

    if (!string.IsNullOrEmpty(Model.Class))
    {
        classes.Add(Model.Class);
    }

    // The band styles its own title, so the class comes from here rather than from every caller.
    var heading = Model.Heading != null
        ? new HeadingViewModel
        {
            Class = $"band__title {Model.Heading.Class}".TrimEnd(),
            Title = Model.Heading.Title,
            Type = Model.Heading.Type
        }
        : null;
}

<section class="@string.Join(' ', classes)"
         id="@Model.Id"
         data-bs-theme="@bsTheme"
         data-odk-component="_Band">
    @if (Model.Hero)
    {
        <div class="band--hero__content">
            <div class="d-flex flex-column gap-3">
                @if (heading != null)
                {
                    @await Html.PartialAsync("Components/_Heading", heading)
                }
                @if (!string.IsNullOrEmpty(Model.Subtitle))
                {
                    <p class="band__subtitle">@Model.Subtitle</p>
                }
                @if (Model.Content != null)
                {
                    <div>
                        @Model.Content.Invoke(null)
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @if (heading != null)
            {
                @await Html.PartialAsync("Components/_Heading", heading)
            }
            @if (!string.IsNullOrEmpty(Model.Subtitle))
            {
                <p class="band__subtitle">@Model.Subtitle</p>
            }
            @if (Model.Content != null)
            {
                <div>
                    @Model.Content.Invoke(null)
                </div>
            }
        </div>
    }
</section>
