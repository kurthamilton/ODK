@using ODK.Core.Utils
@using ODK.Services.Payments
@using ODK.Services.Subscriptions.ViewModels
@using ODK.Web.Razor.Models.Components
@model SiteSubscriptionsViewModel
@{
    var (
        currency, 
        currentMember, 
        memberSubscription, 
        subscriptions, 
        paymentSettings,
        externalSubscription) = (
        Model.Currency, 
        Model.CurrentMember, 
        Model.CurrentMemberSubscription, 
        Model.Subscriptions, 
        Model.SitePaymentSettings,
        Model.CurrentMemberExternalSubscription);

    subscriptions = subscriptions
        .OrderBy(x => x.Subscription.DisplayOrder)
        .ToArray();
}

@if (currency == null)
{
    var currencyOptions = Model.Currencies
        .Select(x => new SelectListItem { Value = x.Id.ToString(), Text = x.ToString() })
        .OrderBy(x => x.Text)
        .ToArray();

    <form action="/account/currency" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group mb-3 required">
            @Html.Label("currencyId", "Choose currency", new { @class = "form-label" })
            @Html.DropDownList("currencyId", currencyOptions, "", new 
            { 
                @class = "form-select", 
                data_val = "true", 
                data_val_required = "The Currency field is required" 
            })
            @Html.ValidationMessage("currencyId")
        </div>

        <button class="btn btn-primary">Update</button>
    </form>
    return;
}

<div data-odk-component="_SiteSubscriptionContent">
    <div class="form-group mb-3">
        <label class="form-label">Current subscription</label>
        <div class="form-control-plaintext">
            <span>@(memberSubscription?.SiteSubscription.Name ?? "-")</span>

            @if (externalSubscription?.Status == ExternalSubscriptionStatus.Cancelled)
            {
                <div class="badge text-bg-warning ms-1">
                    Cancelled
                </div>
            }
        </div>
    </div>

    <div class="form-group mb-3">
        @if (externalSubscription?.Status == ExternalSubscriptionStatus.Cancelled)
        {
            <label class="form-label">Expiry date</label>
            <div class="form-control-plaintext">
                @if (memberSubscription?.MemberSiteSubscription.ExpiresUtc != null)
                {
                    <span>
                        @memberSubscription.MemberSiteSubscription.ExpiresUtc.Value.ToFriendlyDateString(new FriendlyDateStringOptions { TimeZone = currentMember?.TimeZone })
                    </span>
                }
                else
                {
                    <span>-</span>
                }
            </div>
        }
        else if (externalSubscription?.Status == ExternalSubscriptionStatus.Active)
        {
            @* An active subscription's stored expiry is the provider's next billing date, so only one of the
               two is worth showing - and it is read live from the provider, which is authoritative if a
               renewal webhook has yet to arrive. *@
            <label class="form-label">Next payment date</label>
            <div class="form-control-plaintext">
                @if (externalSubscription.NextBillingDate != null && currentMember != null)
                {
                    <span>
                        @externalSubscription.NextBillingDate.Value.ToFriendlyDateString(new FriendlyDateStringOptions
                        { 
                            FullMonthName = true, 
                            ForceIncludeYear = true, 
                            TimeZone = currentMember.TimeZone 
                        })
                    </span>
                }
                else
                {
                    <span>-</span>
                }
            </div>
        }
    </div>

    @if (currentMember != null &&
         memberSubscription != null && 
         externalSubscription?.Status == ExternalSubscriptionStatus.Active)
    {
        <div class="mb-3">
            <form method="post">
                @Html.AntiForgeryToken()

                @await Html.PartialAsync("Components/_Confirm", new ConfirmViewModel
                {
                    Message = "Are you sure you want to cancel your subscription?",
                    Title = "Cancel subscription"
                })
                <p>
                    <button class="btn btn-danger">
                        Cancel subscription
                    </button>
                </p>       
                <p>
                    @await Html.PartialAsync("Components/_FormLabelSubtitle", 
                        "Your subscription will remain active until the expiry date, " + 
                        "but payment will not be taken when due for renewal.")
                </p>
            </form>
        </div>
    }

    @if (!subscriptions.Any(x => x.Subscription.Id != Model.CurrentMemberSubscription?.SiteSubscription.Id) && 
        externalSubscription?.Status == ExternalSubscriptionStatus.Active)
    {
        @*Don't show upgrade options if there are no other subscription options than the current active subscription*@
        return;
    }

    <h3>Purchase</h3>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3">
        @foreach (var subscription in subscriptions)
        {
            <div class="mb-3 col">
                @await Html.PartialAsync("Account/_SiteSubscriptionCard", subscription)
            </div>
        }
    </div>
</div>