@using ODK.Web.Razor.Models.Account
@using ODK.Web.Razor.Mvc
@model ChangeEmailFormViewModel

<div class="form-group mb-3">
    <label class="form-label">Current email address</label>
    <div class="form-control-plaintext">@Model.Current</div>
</div>

<div class="form-group mb-3 required">
    @Html.LabelFor(x => x.Email, new { @class = "form-label" })
    @Html.OdkEmailBoxFor(x => x.Email, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.Email)
</div>