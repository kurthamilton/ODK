@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Models.Login
@model LoginViewModel

@await Html.PartialAsync("Account/_LoginForm")

<hr/>

@* Carries the return URL the same way the password form does. Without it a member who was sent here from
   somewhere - the create-group form most of all - is signed in and then dropped at the home page. *@
<form action="/account/login/google?returnUrl=@Model.ReturnUrl" method="post" data-oauth-submit>
    @Html.AntiForgeryToken()
    <input type="hidden" name="token" data-oauth-token />
    @await Html.PartialAsync("Components/_GoogleLoginButton", new GoogleLoginButtonViewModel
    {
        ClientId = Model.GoogleClientId,
        Text = "Sign in with Google"
    })
</form>