@using ODK.Services.Events.ViewModels
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Components
@model EventAdminPageViewModelBase
@inject IHttpContextAccessor HttpContextAccessor
@inject IOdkRoutes OdkRoutes
@{
    var routes = OdkRoutes.GroupAdmin;

    var menuItems = new List<MenuItem>
    {
        new MenuItem
        {
            ActiveIsExactMatch = true,
            Link = routes.Event(Model.Chapter, Model.Event.Id).Path,
            Text = "Edit"
        },
        new MenuItem
        {
            Link = routes.EventInvites(Model.Chapter, Model.Event.Id).Path,
            Text = "Invites"
        },
        new MenuItem
        {
            Link = routes.EventResponses(Model.Chapter, Model.Event.Id).Path,
            Text = "Responses"
        },
        new MenuItem
        {
            Link = routes.EventComments(Model.Chapter, Model.Event.Id).Path,
            Text = "Comments"
        }
    };

    if (Model.Event.Ticketed)
    {
        menuItems.Add(new MenuItem { Link = routes.EventTickets(Model.Chapter, Model.Event.Id).Path, Text = "Tickets" });
    }
}

@await Html.PartialAsync("Components/_Tabs", new TabsViewModel
{
    MenuItems = menuItems
})