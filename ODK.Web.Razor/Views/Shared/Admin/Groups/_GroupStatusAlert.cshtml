@using ODK.Core.Chapters
@using ODK.Web.Common.Routes
@model Chapter
@inject IOdkRoutes OdkRoutes

@if (!Model.Approved())
{
    <div class="alert alert-warning">
        @if (Model.SubmittedForApproval())
        {
            <text>
                This group has been submitted and is waiting for approval. You can carry on making changes,
                but you won't be able to publish it until it has been approved.
            </text>
        }
        else
        {
            @* It has not asked yet, so the thing standing between it and approval is its own checklist. *@
            <text>
                This group hasn't been submitted for approval yet. Finish setting it up and submit it from
                the <a href="@OdkRoutes.GroupAdmin.Group(Model).Path">admin page</a>.
            </text>
        }
    </div>
}
else if (!Model.IsPublished())
{
    var publishPath = OdkRoutes.GroupAdmin.Group(Model).Path;
    var currentPath = Context.Request.Path;

    if (!string.Equals(publishPath, currentPath, StringComparison.OrdinalIgnoreCase))
    {
        <div class="alert alert-warning">
            This group is not published. <a href="@publishPath">Publish</a>
        </div>
    }    
}
