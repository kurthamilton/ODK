@using ODK.Data.Core.Events
@using ODK.Data.Core.Members
@using ODK.Services.Chapters.ViewModels
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Admin
@using ODK.Web.Razor.Models.Admin.Events
@using ODK.Web.Razor.Models.Admin.Members
@using ODK.Web.Razor.Models.Components
@model GroupDashboardViewModel
@inject IOdkRoutes OdkRoutes
@{
    var headingType = HeadingType.H5;
}

<div class="section-stack">
    @* First, and only while the group is waiting to be published: publishing is what an approved group
       nobody can see yet is for, and the section owns both faces of it - the action and whatever is
       standing in the way of it. *@
    @if (Model.AwaitingPublication)
    {
        @await Html.PartialAsync("Components/_Panel", new PanelViewModel
        {
            Heading = new HeadingViewModel
            {
                Title = "Publish this group",
                Type = headingType
            },
            BodyContentFunc = @<div>@await Html.PartialAsync("Admin/Groups/_GroupDashboardPublish", Model)</div>
        })
    }

    @await Html.PartialAsync("Components/_Panel", new PanelViewModel
    {
        Heading = new HeadingViewModel
        {
            Title = "Needs your attention",
            Type = headingType
        },
        BodyContentFunc = @<div>@await Html.PartialAsync("Admin/Groups/_GroupDashboardActions", Model)</div>
    })

    @if (Model.PromptMemberImport)
    {
        @await Html.PartialAsync("Components/_Panel", new PanelViewModel
        {
            Heading = new HeadingViewModel
            {
                Title = "Import members",
                Type = headingType
            },
            BodyContentFunc =
                @<div>
                    <p>
                        Nobody else has joined this group yet. If you already run it somewhere else,
                        upload your member list and everyone on it is invited to join you here.
                    </p>
                    <p class="text-muted">
                        Nobody is emailed until you send the invites.
                    </p>
                    @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
                    {
                        Class = "btn btn-primary",
                        Icon = IconType.Upload,
                        Route = OdkRoutes.GroupAdmin.MembersImport(Model.Chapter),
                        Text = "Import members"
                    })
                </div>
        })
    }

    @if (Model.PromptMovedPage)
    {
        @await Html.PartialAsync("Components/_Panel", new PanelViewModel
        {
            Heading = new HeadingViewModel
            {
                Title = "Tell your old community",
                Type = headingType
            },
            BodyContentFunc =
                @<div>
                    <p>
                        If this group ran somewhere else before, it can have a page there that points
                        here - with your next event on it. Put its address in your old group's
                        description and anyone still finding you there is sent straight to you.
                    </p>
                    <p class="text-muted">
                        Nothing is published until you switch the page on.
                    </p>
                    <div class="button-container">
                        @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
                        {
                            Class = "btn btn-primary",
                            Icon = IconType.Home,
                            Route = OdkRoutes.GroupAdmin.Moved(Model.Chapter),
                            Text = "Set up the moved page"
                        })

                        @* Posts rather than links, because it writes. The dismissal is the group's, so it
                           takes this panel off the dashboard for every organiser. *@
                        <form method="post" action="@OdkRoutes.GroupAdmin.MovedDismiss(Model.Chapter).Path">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-link">This group didn't move here</button>
                        </form>
                    </div>
                </div>
        })
    }

    @* The second half of the same job: the page exists, so the outstanding action is telling people it
       does. Nobody goes looking for wording they do not know is there. *@
    @if (Model.PromptShareMovedPage)
    {
        @await Html.PartialAsync("Components/_Panel", new PanelViewModel
        {
            Heading = new HeadingViewModel
            {
                Title = "Tell your old community",
                Type = headingType
            },
            BodyContentFunc =
                @<div>
                    <p>
                        Your moved page is live. The last thing between you and everyone finding you is
                        telling them - and we have written the words, with your group's name and address
                        already in them.
                    </p>
                    <div class="button-container">
                        @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
                        {
                            Class = "btn btn-primary",
                            Icon = IconType.Copy,
                            Route = OdkRoutes.GroupAdmin.Moved(Model.Chapter),
                            Text = "Get the words"
                        })
                    </div>
                </div>
        })
    }

    @if (Model.UpcomingEvents != null)
    {
        @* A section is null when the admin can't reach the page behind it, and empty when the group has
           nothing to show there. The panel body is a closure, which nullable flow analysis does not reach
           into, so each section binds its collection to a non-null local first. *@
        IReadOnlyCollection<EventSummaryDto> upcomingEvents = Model.UpcomingEvents;

        @await Html.PartialAsync("Components/_Panel", new PanelViewModel
        {
            Heading = new HeadingViewModel
            {
                Title = "Upcoming events",
                Type = headingType
            },
            TitleEndContentFunc = @<a href="@OdkRoutes.GroupAdmin.Events(Model.Chapter).Path">See all</a>,
            BodyContentFunc =
                @<div>
                    @if (upcomingEvents.Count == 0)
                    {
                        <p class="text-muted">There are no upcoming events.</p>

                        @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
                        {
                            Class = "btn btn-primary",
                            Icon = IconType.Plus,
                            Route = OdkRoutes.GroupAdmin.EventCreate(Model.Chapter),
                            Text = "Create an event",
                            UnauthorizedBehaviour = AdminLinkUnauthorizedBehaviour.Hide
                        })
                    }
                    else
                    {
                        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                            @foreach (var upcomingEvent in upcomingEvents)
                            {
                                <div class="col">
                                    @await Html.PartialAsync("Admin/Events/_EventAdminCard", new EventAdminCardViewModel
                                    {
                                        Chapter = Model.Chapter,
                                        Summary = upcomingEvent
                                    })
                                </div>
                            }
                        </div>
                    }
                </div>
        })
    }

    @if (Model.NewestMembers != null)
    {
        IReadOnlyCollection<MemberChapterWithAvatarDto> newestMembers = Model.NewestMembers;

        @await Html.PartialAsync("Components/_Panel", new PanelViewModel
        {
            Heading = new HeadingViewModel
            {
                Title = "Newest members",
                Type = headingType
            },
            TitleEndContentFunc = @<a href="@OdkRoutes.GroupAdmin.Members(Model.Chapter).Path">See all</a>,
            BodyContentFunc =
                @<div>
                    @if (newestMembers.Count == 0)
                    {
                        <p class="text-muted mb-0">Nobody has joined this group yet.</p>
                    }
                    else
                    {
                        <div class="row row-cols-2 row-cols-md-4 g-3">
                            @foreach (var newestMember in newestMembers)
                            {
                                <div class="col">
                                    @await Html.PartialAsync("Admin/Members/_MemberAdminCard", new MemberAdminCardViewModel
                                    {
                                        Chapter = Model.Chapter,
                                        Member = newestMember
                                    })
                                </div>
                            }
                        </div>
                    }
                </div>
        })
    }
</div>
