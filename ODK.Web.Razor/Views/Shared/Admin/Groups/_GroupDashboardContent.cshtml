@using ODK.Data.Core.Events
@using ODK.Data.Core.Members
@using ODK.Services.Chapters.ViewModels
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Admin
@using ODK.Web.Razor.Models.Admin.Events
@using ODK.Web.Razor.Models.Admin.Members
@using ODK.Web.Razor.Models.Components
@model GroupDashboardViewModel
@inject IOdkRoutes OdkRoutes

<div class="section-stack">
    @await Html.PartialAsync("Components/_Panel", new PanelViewModel
    {
        Heading = new HeadingViewModel
        {
            Title = "Needs your attention",
            Type = HeadingType.H4
        },
        BodyContentFunc = @<div>@await Html.PartialAsync("Admin/Groups/_GroupDashboardActions", Model)</div>
    })

    @if (Model.UpcomingEvents != null)
    {
        @* A section is null when the admin can't reach the page behind it, and empty when the group has
           nothing to show there. The panel body is a closure, which nullable flow analysis does not reach
           into, so each section binds its collection to a non-null local first. *@
        IReadOnlyCollection<EventSummaryDto> upcomingEvents = Model.UpcomingEvents;

        @await Html.PartialAsync("Components/_Panel", new PanelViewModel
        {
            Heading = new HeadingViewModel
            {
                Title = "Upcoming events",
                Type = HeadingType.H4
            },
            TitleEndContentFunc = @<a href="@OdkRoutes.GroupAdmin.Events(Model.Chapter).Path">See all</a>,
            BodyContentFunc =
                @<div>
                    @if (upcomingEvents.Count == 0)
                    {
                        <p class="text-muted">There are no upcoming events.</p>

                        @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
                        {
                            Class = "btn btn-primary",
                            Icon = IconType.Plus,
                            Route = OdkRoutes.GroupAdmin.EventCreate(Model.Chapter),
                            Text = "Create an event",
                            UnauthorizedBehaviour = AdminLinkUnauthorizedBehaviour.Hide
                        })
                    }
                    else
                    {
                        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                            @foreach (var upcomingEvent in upcomingEvents)
                            {
                                <div class="col">
                                    @await Html.PartialAsync("Admin/Events/_EventAdminCard", new EventAdminCardViewModel
                                    {
                                        Chapter = Model.Chapter,
                                        Summary = upcomingEvent
                                    })
                                </div>
                            }
                        </div>
                    }
                </div>
        })
    }

    @if (Model.NewestMembers != null)
    {
        IReadOnlyCollection<MemberChapterWithAvatarDto> newestMembers = Model.NewestMembers;

        @await Html.PartialAsync("Components/_Panel", new PanelViewModel
        {
            Heading = new HeadingViewModel
            {
                Title = "Newest members",
                Type = HeadingType.H4
            },
            TitleEndContentFunc = @<a href="@OdkRoutes.GroupAdmin.Members(Model.Chapter).Path">See all</a>,
            BodyContentFunc =
                @<div>
                    @if (newestMembers.Count == 0)
                    {
                        <p class="text-muted mb-0">Nobody has joined this group yet.</p>
                    }
                    else
                    {
                        <div class="row row-cols-2 row-cols-md-4 g-3">
                            @foreach (var newestMember in newestMembers)
                            {
                                <div class="col">
                                    @await Html.PartialAsync("Admin/Members/_MemberAdminCard", new MemberAdminCardViewModel
                                    {
                                        Chapter = Model.Chapter,
                                        Member = newestMember
                                    })
                                </div>
                            }
                        </div>
                    }
                </div>
        })
    }
</div>
