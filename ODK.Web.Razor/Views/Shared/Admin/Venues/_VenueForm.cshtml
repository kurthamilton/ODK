@using ODK.Web.Razor.Models.Components
@model ODK.Web.Razor.Models.Admin.Venues.VenueFormViewModel

@* The lookup is what a venue is, so it comes first and is the only required field. The name below it
   arrives filled in from the place, and is edited only to call the venue something else. *@
<div class="form-group mb-3 required">
    @Html.LabelFor(x => x.LocationName, new { @class = "form-label" })
    @await Html.PartialAsync("Components/_LocationPicker", Model)
</div>

<div class="form-group mb-3">
    @Html.LabelFor(x => x.Name, new { @class = "form-label" })
    @await Html.PartialAsync("Components/_FormLabelSubtitle", "What your group calls this venue")
    @Html.TextBoxFor(x => x.Name, new { @class = "form-control", data_location_name = "" })
    @Html.ValidationMessageFor(x => x.Name)
</div>

<div class="form-group mb-3">
    @Html.LabelFor(x => x.AdditionalInfo, new { @class = "form-label" })
    @await Html.PartialAsync("Components/_FormLabelSubtitle", "How to find it - which entrance, who to ask for")
    @Html.TextAreaFor(x => x.AdditionalInfo, new { @class = "form-control", rows = 3 })
</div>

<div class="my-3">
    @await Html.PartialAsync("Components/_GoogleMap", new GoogleMapViewModel
    {
        Query = !string.IsNullOrEmpty(Model.ExternalId) ? $"place_id:{Model.ExternalId}" : null,
        QuerySource = "#map-place-query"
    })
</div>
