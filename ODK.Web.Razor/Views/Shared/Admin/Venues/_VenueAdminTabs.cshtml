@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Admin.Events
@using ODK.Web.Razor.Models.Components
@model VenueAdminTabsViewModel
@inject IOdkRoutes OdkRoutes

@await Html.PartialAsync("Components/_Tabs", new TabsViewModel
{
    MenuItems = new[]
    {
        new MenuItem
        {
            ActiveIsExactMatch = true,
            Link = OdkRoutes.GroupAdmin.Venue(Model.Chapter, Model.ChapterVenue.Id).Path,
            Text = "Edit"
        },
        new MenuItem
        {
            Link = OdkRoutes.GroupAdmin.VenueEvents(Model.Chapter, Model.ChapterVenue.Id).Path,
            Text = "Events"
        }
    }
})