@using ODK.Services.Venues.ViewModels
@using ODK.Web.Razor.Models.Admin.Events
@using ODK.Web.Razor.Models.Admin.Venues
@model VenueAdminPageViewModel

@await Html.PartialAsync("Components/_AdminPageDescription",
    "Change this venue. Events already using it pick up the change.")

@await Html.PartialAsync("Admin/Venues/_VenueAdminTabs", new VenueAdminTabsViewModel
{
    Chapter = Model.Chapter,
    Platform = Model.Platform,
    ChapterVenue = Model.ChapterVenue
})

<form method="post">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("Admin/Venues/_VenueForm", new VenueFormViewModel
    {
        AdditionalInfo = Model.ChapterVenue.AdditionalInfo,
        ExternalId = Model.Location?.ExternalId,
        Lat = Model.Location?.LatLong.Lat,
        LocationName = Model.Location?.Name ?? Model.Location?.MapQuery ?? string.Empty,
        Long = Model.Location?.LatLong.Long,
        Name = Model.ChapterVenue.GetName(),
        SearchNear = Model.ChapterLocation?.LatLong
    })
    
    <button type="submit" class="btn btn-primary">Update</button>
</form>