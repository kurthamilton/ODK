@using ODK.Services.Members.ViewModels
@using ODK.Web.Razor.Models.Admin.Members
@using ODK.Web.Razor.Models.Components
@model MemberImportAdminPageViewModel

@await Html.PartialAsync("Components/_AdminPageDescription",
    "Invite members to the group from a CSV file. Nobody is emailed until you send the invites, and " +
    "anyone the file has a problem with stays on this page until you deal with them." +
    (Model.Chapter.IsPublished()
        ? string.Empty
        : " You can upload a file before the group is published, but the invites cannot be sent until "
          + "it is."))

<div class="section-stack" data-odk-component="_ImportMembersContent">
    @await Html.PartialAsync("Components/_Section", new SectionViewModel
    {
        Heading = new HeadingViewModel
        {
            Title = "Upload a file",
            Type = HeadingType.H3
        },
        BodyContentFunc = @<div>
            @await Html.PartialAsync("Admin/Members/_ImportMembersUpload", new MemberImportUploadViewModel
            {
                Chapter = Model.Chapter
            })
        </div>
    })

    @await Html.PartialAsync("Admin/Members/_ImportMembersStaged", Model)
</div>
