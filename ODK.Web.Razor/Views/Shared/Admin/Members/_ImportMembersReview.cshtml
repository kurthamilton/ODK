@using ODK.Core.Utils
@using ODK.Services.Members.Models
@using ODK.Web.Razor.Models.Admin.Members
@using ODK.Web.Razor.Models.Components
@model MemberImportReviewViewModel
@{
    var preview = Model.Preview;
    var capacity = preview.Capacity;
    var importableRows = preview.ImportableRows.ToArray();
    var remaining = capacity.Remaining ?? 0;
    var canImport = importableRows.Length > 0 && preview.FitsWithinCapacity;

    /* Whether the site already knows this person, not what the import does to them - everyone importable is
       invited, and the summary below says so. A label naming the action would have to say "invite" twice. */
    (string Label, string CssClass) StatusBadge(MemberImportRowStatus status) => status switch
    {
        MemberImportRowStatus.New => ("New", "bg-success"),
        MemberImportRowStatus.ExistingNotInGroup => ("Existing", "bg-primary"),
        MemberImportRowStatus.ExistingInGroup => ("Already in group", "bg-secondary"),
        _ => (status.ToString(), "bg-secondary")
    };
}

<p>
    <span class="badge bg-success">@preview.NewCount new</span>
    <span class="badge bg-primary">@preview.ExistingNotInGroupCount existing</span>
    <span class="badge bg-secondary">@preview.ExistingInGroupCount already in group</span>
</p>

<div class="table-responsive">
    <table class="table" data-table-striped>
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in preview.Rows)
            {
                var (label, cssClass) = StatusBadge(row.Status);
                var skipped = row.Status == MemberImportRowStatus.ExistingInGroup;

                <tr class="@(skipped ? "text-muted" : null)">
                    <td>@row.Member.FirstName @row.Member.LastName</td>
                    <td>@row.Member.EmailAddress</td>
                    <td><span class="badge @cssClass">@label</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (importableRows.Length == 0)
{
    <div class="alert alert-info">There is nobody to invite from this file.</div>
}

@if (importableRows.Length > 0 && !preview.FitsWithinCapacity)
{
    <div class="alert alert-warning">
        @if (!capacity.HasOwnerSubscription)
        {
            <span>This group's plan is not active, so it cannot invite new members.</span>
        }
        else
        {
            <p>
                <span>This group has room for </span>
                <strong>@remaining more @StringUtils.Pluralise(remaining, "member")</strong>
                <span>
                    - it has @capacity.MemberCount
                    @StringUtils.Pluralise(capacity.MemberCount, "member") and
                    @capacity.OutstandingInviteCount outstanding
                    @StringUtils.Pluralise(capacity.OutstandingInviteCount, "invite"), against a limit of
                    @capacity.Limit.
                </span>
                <span>This file needs <strong>@preview.PlacesRequired</strong>.</span>
            </p>
            <p class="mb-0">
                Remove @(preview.PlacesRequired - remaining)
                @StringUtils.Pluralise(preview.PlacesRequired - remaining, "row") from the file, or move to a
                plan with a higher member limit.
            </p>
        }
    </div>
}

@if (canImport)
{
    <p>
        <span>You're about to invite </span>
        <strong>@importableRows.Length @StringUtils.Pluralise(importableRows.Length, "member")</strong>
        <span> to the group. They become members when they accept.</span>
    </p>
    <ul>
        @if (preview.NewCount > 0)
        {
            <li>
                @preview.NewCount new @StringUtils.Pluralise(preview.NewCount, "member")
            </li>
        }

        @if (preview.ExistingNotInGroupCount > 0)
        {
            <li>
                @preview.ExistingNotInGroupCount existing @StringUtils.Pluralise(preview.ExistingNotInGroupCount, "member")
            </li>
        }

        @if (preview.ExistingInGroupCount > 0)
        {
            <li>
                @preview.ExistingInGroupCount already in the group will be skipped.
            </li>
        }
    </ul>

    @if (capacity.Limit != null)
    {
        var left = remaining - preview.PlacesRequired;

        <p>
            <span>After this the group can invite </span>
            <strong>@left more @StringUtils.Pluralise(left, "member")</strong>
            <span> on its current plan.</span>
        </p>
    }

    <form method="post" action="/groups/@Model.Chapter.Id/members/import">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(x => x.Token)

        <button type="submit" class="btn btn-primary">
            @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.Upload))
            <span>Import</span>
        </button>
    </form>
}