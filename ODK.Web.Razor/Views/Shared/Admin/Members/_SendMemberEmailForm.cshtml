@using ODK.Web.Razor.Models.Admin.Members
@model SendMemberEmailFormViewModel

<div class="form-group mb-3 required">
    @Html.LabelFor(x => x.Subject, new { @class = "form-label" })
    @Html.TextBoxFor(x => x.Subject, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.Subject)
</div>

<div class="form-group mb-3 required">
    @Html.LabelFor(x => x.BodyHtml, new { @class = "form-label" })
    @Html.TextAreaFor(x => x.BodyHtml, new { @class = "form-control", data_html_editor = "" })
    @Html.ValidationMessageFor(x => x.BodyHtml)
</div>