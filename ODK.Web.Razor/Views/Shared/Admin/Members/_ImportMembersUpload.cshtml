@using ODK.Services.Members.Models
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Admin
@using ODK.Web.Razor.Models.Admin.Members
@using ODK.Web.Razor.Models.Components
@model MemberImportUploadViewModel
@inject IOdkRoutes OdkRoutes
@{
    var csvHeader = MemberImportCsvRow.GetCsvHeaderRow();
}

<p>
    <span>The file must contain </span>
    @for (var i = 0; i < csvHeader.Count; i++)
    {
        var column = csvHeader.ElementAt(i);
        <code>@column</code>
        @if (i < csvHeader.Count - 1)
        {
            <span>, </span>
        }
    }
    <span>columns. Uploading a file again updates the people it already holds rather than repeating them.</span>
</p>

<p>
    @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
    {
        Icon = IconType.Excel,
        Route = OdkRoutes.GroupAdmin.MembersImportTemplateDownload(Model.Chapter),
        Text = "Download template"
    })
</p>

<form method="post" enctype="multipart/form-data"
      action="@OdkRoutes.GroupAdmin.MembersImportUpload(Model.Chapter).Path"
      data-odk-component="_ImportMembersUpload">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        @Html.TextBoxFor(x => x.File, new
        {
            type = "file",
            accept = ".csv",
            @class = "form-control"
        })
        @Html.ValidationMessageFor(x => x.File)
    </div>

    <button type="submit" class="btn btn-primary">
        @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.Upload))
        <span>Upload</span>
    </button>
</form>
