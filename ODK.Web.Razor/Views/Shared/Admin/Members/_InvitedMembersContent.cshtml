@using ODK.Core.Utils
@using ODK.Services.Members.ViewModels
@using ODK.Web.Razor.Mvc
@model InvitedMembersAdminPageViewModel
@{
    var timeZone = Html.DisplayTimeZone(Model.Chapter.TimeZone);
}

@await Html.PartialAsync("Components/_AdminPageDescription",
    "People an import has asked to join who have yet to accept. They become members when they accept, so " +
    "they are not in the members list until then. An invite nobody accepts is deleted after " +
    $"{Model.RetentionDays} days, along with the account raised for it - so a member who never replies " +
    "leaves the group holding nothing about them.")

@if (Model.Invited.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Invited</th>
                    <th>Deleted</th>
                </tr>
            </thead>
            <tbody>
                @* Already ordered oldest first by the query that read them - see the view model. *@
                @foreach (var invite in Model.Invited)
                {
                    <tr>
                        @* Not linked to the member admin page: that page is about a member of the group,
                           and someone who has only been invited is not one yet. *@
                        <td>@invite.Member.FullName</td>
                        <td>
                            @invite.InvitedUtc.ToFriendlyDateString(new FriendlyDateStringOptions
                            {
                                IncludeDayOfWeek = true,
                                TimeZone = timeZone
                            })
                        </td>
                        <td>
                            @if (invite.DaysRemaining > 0)
                            {
                                <text>In @invite.DaysRemaining @StringUtils.Pluralise(invite.DaysRemaining, "day")</text>
                            }
                            else
                            {
                                <text>Due</text>
                            }
                            <div class="text-muted">
                                @invite.DeletedUtc.ToFriendlyDateString(new FriendlyDateStringOptions
                                {
                                    TimeZone = timeZone
                                })
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p>Nobody is waiting to accept an invite</p>
}
