@using ODK.Core.Utils
@using ODK.Services.Members.ViewModels
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Mvc
@model InvitedMembersAdminPageViewModel
@inject IOdkRoutes OdkRoutes
@{
    var timeZone = Html.DisplayTimeZone(Model.Chapter.TimeZone);
}

@await Html.PartialAsync("Components/_AdminPageDescription",
    "People an import has asked to join who have yet to accept. They become members when they accept, so " +
    "they are not in the members list until then. An invite nobody accepts is deleted after " +
    $"{Model.RetentionDays} days, along with the account raised for it - so a member who never replies " +
    "leaves the group holding nothing about them." +
    (Model.Chapter.IsPublished()
        ? string.Empty
        : " Nobody here has been emailed yet, and nobody can be until the group is published: the link "
          + "an invite carries lands on a group nobody outside it can see."))

@* Not an edit of the address. An imported account is a real member record, so changing its address here
   would be an admin editing somebody's account rather than correcting a list. *@
<p class="text-muted">
    To correct a wrong address, cancel the invite and
    <a href="@OdkRoutes.GroupAdmin.MembersImport(Model.Chapter).Path">upload the corrected details</a> again.
</p>

@if (Model.CanSend)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <span>
            <strong>@Model.Held @StringUtils.Pluralise(Model.Held, "invite")</strong>
            @StringUtils.Pluralise(Model.Held, "has", "have") not been emailed yet.
        </span>
        <form action="@OdkRoutes.GroupAdmin.MembersInvitedSend(Model.Chapter).Path" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-warning ms-3 text-nowrap">Send invites</button>
        </form>
    </div>
}

@if (Model.Invited.Count > 0)
{
    @* Only the non-zero halves. A summary that is mostly zeroes teaches people to stop reading it. *@
    <div class="d-flex flex-wrap gap-3 mb-3 text-muted">
        @if (Model.AwaitingActivation > 0)
        {
            <span>@Model.AwaitingActivation awaiting account activation</span>
        }
        @if (Model.ExistingAccounts > 0)
        {
            <span>@Model.ExistingAccounts with an existing account</span>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Details received</th>
                    <th>Deleted</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @* Already ordered oldest first by the query that read them - see the view model. *@
                @foreach (var invite in Model.Invited)
                {
                    <tr>
                        @* Not linked to the member admin page: that page is about a member of the group,
                           and someone who has only been invited is not one yet. *@
                        <td>
                            <span>@invite.Member.FullName</span>
                            @if (invite.SentUtc == null)
                            {
                                <span class="badge bg-secondary">Not emailed</span>
                            }
                        </td>
                        <td>
                            @invite.InvitedUtc.ToFriendlyDateString(new FriendlyDateStringOptions
                            {
                                IncludeDayOfWeek = true,
                                TimeZone = timeZone
                            })
                        </td>
                        <td>
                            @if (invite.DaysRemaining > 0)
                            {
                                <text>In @invite.DaysRemaining @StringUtils.Pluralise(invite.DaysRemaining, "day")</text>
                            }
                            else
                            {
                                <text>Due</text>
                            }
                            <div class="text-muted">
                                @invite.DeletedUtc.ToFriendlyDateString(new FriendlyDateStringOptions
                                {
                                    TimeZone = timeZone
                                })
                            </div>
                        </td>
                        <td>
                            @* A form is a block, so the two sit in a flex row rather than stacking. *@
                            <div class="button-container justify-content-end">
                                @* Only on an invite that has been emailed and is past its cooldown. One the
                                   group is still holding is sent by the batch action above, not resent. *@
                                @if (invite.CanResend)
                                {
                                    <form action="@OdkRoutes.GroupAdmin.MembersInvitedResend(Model.Chapter, invite.Member.Id).Path"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <button data-bs-toggle="tooltip" data-bs-title="Resend invite"
                                                class="btn-icon">
                                            @await Html.PartialAsync("Components/_Icon",
                                                new IconViewModel(IconType.Envelope))
                                        </button>
                                    </form>
                                }
                                <form action="@OdkRoutes.GroupAdmin.MembersInvitedCancel(Model.Chapter, invite.Member.Id).Path"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    @await Html.PartialAsync("Components/_Confirm", new ConfirmViewModel
                                    {
                                        Message = $"{invite.Member.FullName} will no longer be able to accept. " +
                                                  "If they have not activated an account here, the one raised " +
                                                  "for them is deleted with the invite.",
                                        Title = "Cancel invite"
                                    })
                                    <button data-bs-toggle="tooltip" data-bs-title="Cancel invite"
                                            class="btn-icon text-danger">
                                        @await Html.PartialAsync("Components/_Icon",
                                            new IconViewModel(IconType.Times))
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p>Nobody is waiting to accept an invite</p>
}
