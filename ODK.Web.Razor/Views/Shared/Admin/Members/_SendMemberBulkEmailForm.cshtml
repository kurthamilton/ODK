@using ODK.Core.Features
@using ODK.Services.Members.ViewModels
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Admin.Members
@using ODK.Web.Razor.Models.Components
@model MembersAdminPageViewModel
@inject IOdkRoutes OdkRoutes

@* Its own partial rather than markup inside the panel that frames it: Razor allows only one level of inline
   markup block, and the panel already spends it on its title. *@
<form method="post" action="/groups/@Model.Chapter.Id/members/email" id="@BulkEmailElements.FormId"
      data-odk-component="_SendMemberBulkEmailForm">
    @Html.AntiForgeryToken()

    @await Html.PartialAsync("Components/_RestrictedFeature", new RestrictedFeatureViewModel(Model.HasBulkEmailFeature)
    {
        Chapter = Model.Chapter,
        Feature = SiteFeatureType.SendMemberEmails,
        ContentFunc =
            @<div>
                <p class="text-muted">
                    Pick your recipients with the checkboxes in the table below. Filtering changes who is
                    listed, not who is ticked, so you can filter, select, filter again, and send to
                    everyone you gathered along the way.
                </p>

                @await Html.PartialAsync("Admin/Members/_SendMemberEmailForm", new SendMemberEmailFormViewModel())

                <div class="button-container">
                    <button type="submit" class="btn btn-primary" data-bulk-email-send>Send</button>
                    @* Leaves the mode rather than the page where scripting is available - see
                       odk.bulk-email.js, which takes the click. *@
                    <a href="@OdkRoutes.GroupAdmin.Members(Model.Chapter).Path" class="btn btn-secondary"
                       data-bulk-email-cancel>Cancel</a>
                    <span class="form-text" data-bulk-email-count></span>

                    @* A table filter in its own right, declared the same way as the ones above the table, so
                       odk.lists.js runs it with the rest rather than the script having to hide rows itself.
                       It reads the data-filter-selected each row carries - see odk.bulk-email.js, which is
                       what writes that and what clears the other filters when this one comes on.

                       No name, so it posts nothing: it says what is on screen, not who is being written to. *@
                    <div class="form-check form-switch form-switch-sm ms-auto">
                        <input class="form-check-input" type="checkbox" role="switch" value="true"
                               id="bulk-email-only-selected" data-bulk-email-only-selected
                               data-table-filter="@BulkEmailElements.MembersTableSelector"
                               data-table-filter-field="selected" />
                        <label class="form-check-label" for="bulk-email-only-selected">Selected only</label>
                    </div>
                </div>
            </div>
    })
</form>