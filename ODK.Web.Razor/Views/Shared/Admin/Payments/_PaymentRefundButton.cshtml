@using ODK.Services.Payments.ViewModels
@using ODK.Web.Razor.Models.Admin.Payments
@using ODK.Web.Razor.Models.Components
@model PaymentItemViewModel

@if (Model.RefundableAmount > 0)
{
    @* data-odk-tooltip rather than data-bs-toggle, which the modal has taken - see bindTooltips in
       odk.js. *@
    <button type="button" class="btn-icon"
            data-bs-toggle="modal"
            data-bs-target="#@PaymentRefundElements.ModalId(Model.Payment.Id)"
            data-odk-tooltip data-bs-title="Refund this payment"
            aria-label="Refund this payment">
        @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.Undo))
    </button>
}
