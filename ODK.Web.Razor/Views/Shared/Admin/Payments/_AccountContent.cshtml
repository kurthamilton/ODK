@using ODK.Core.Features
@using ODK.Services.Chapters.ViewModels
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Admin
@using ODK.Web.Razor.Models.Components
@model ChapterPaymentAccountAdminPageViewModel
@inject IOdkRoutes OdkRoutes

<div data-odk-component="_AccountContent">
    @await Html.PartialAsync("Components/_AdminPageDescription",
        "Connect a payment account so your group can take money for memberships and tickets.")

    @* Payments is gated on the owner's subscription like every other paid feature. Uses the Permitted
       overload because access is already resolved into the view model rather than exposed as a feature
       list, which is what that constructor exists for. *@
    @await Html.PartialAsync("Components/_RestrictedFeature", new RestrictedFeatureViewModel(Model.HasPermission)
    {
        Chapter = Model.Chapter,
        Feature = SiteFeatureType.Payments,
        ContentFunc =
            @<div>
                @if (Model.Enabled)
                {
                    <div class="alert alert-success">
                        <span>You have set up a payment account. Set up your </span>
                        @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
                        {
                            Route = OdkRoutes.GroupAdmin.Subscriptions(Model.Chapter),
                            Text = "subscriptions"
                        })
                        <span>.</span>
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.OnboardingUrl))
                {
                    <a href="@Model.OnboardingUrl" class="btn btn-primary">Resume setup</a>
                    <span class="ms-2 small text-muted"
                        data-redirect-timer-url="@Model.OnboardingUrl" data-redirect-timer-seconds="5">
                        @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.CircleNotch))
                        <span>Redirecting in </span>
                        <span data-redirect-timer-remaining>5</span>
                        <span>seconds</span>
                    </span>
                }
                else
                {
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-primary">Create</button>
                    </form>
                }
            </div>
    })
</div>
