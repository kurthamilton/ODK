@using ODK.Services.Payments.ViewModels
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Admin
@model ChapterPaymentsViewModel
@inject IOdkRoutes OdkRoutes

@* Neither the provider nor the platform is named: the wording is shared by both platforms, and which
   provider took the fee is not something a group has any say in. *@
@await Html.PartialAsync("Components/_AdminPageDescription",
    "Money your group has taken, including what each payment was for. Paid is what the member was " +
    "charged; Received is your share of it, minus fees.")

<div data-odk-component="_ChapterAdminPaymentsContent">
    @if (!Model.PaymentAccountEnabled)
    {
        <div class="alert alert-warning">
            <span>Your group cannot take money until its payment account is set up.</span>
            @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
            {
                Route = OdkRoutes.GroupAdmin.PaymentAccount(Model.Chapter),
                Text = "Set up payment account",
                UnauthorizedBehaviour = AdminLinkUnauthorizedBehaviour.Hide
            })
        </div>
    }

    <div class="table-responsive">
        <table class="table" data-sortable id="payments-table" data-table-striped>
            <thead>
                <tr>
                    <th data-sortable-sort="default" data-sortable-dir="desc">Date</th>
                    <th data-sortable-sort>Member</th>
                    <th>Reference</th>
                    <th>Paid</th>
                    <th>Received</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Payments.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-muted">No payments received yet.</td>
                    </tr>
                }

                @foreach (var dto in Model.Payments)
                {
                    var (currency, member, payment) = (dto.Payment.Currency, dto.Member, dto.Payment);

                    if (payment.PaidUtc == null)
                    {
                        continue;
                    }

                    <tr>
                        <td>
                            @Model.Chapter.ToChapterTime(payment.PaidUtc.Value).ToString("yyyy-MM-dd HH:mm:ss")
                        </td>
                        <td>
                            <span class="d-none" data-sort-value="@member.FullName"></span>
                            @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
                            {
                                Route = OdkRoutes.GroupAdmin.MemberPayments(Model.Chapter, member.Id),
                                Text = member.FullName
                            })
                        </td>
                        <td>@payment.Reference</td>
                        <td>
                            @currency.ToAmountString(payment.Amount)
                        </td>
                        <td>
                            @* A dash rather than a zero: nothing has been read back from the payment
                               provider for this one yet, which is not the same as receiving nothing. *@
                            @(payment.ActualConnectedAccountAmount != null
                                ? currency.ToAmountString(payment.ActualConnectedAccountAmount.Value)
                                : "-")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>