@using System.Globalization
@using ODK.Core.Utils
@using ODK.Services.Payments.ViewModels
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Admin
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Mvc
@model ChapterPaymentsViewModel
@inject IOdkRoutes OdkRoutes
@{
    // Date, Member, Reference, Paid, Received, Refunded, and the site admin's own action column.
    var columnCount = Model.ViewedBySiteAdmin ? 7 : 6;

    var dateTimeOptions = new FriendlyDateStringOptions
    {
        ForceIncludeTime = true,
        ForceIncludeYear = true,
        TimeZone = Html.DisplayTimeZone(Model.Chapter.TimeZone)
    };
}

@await Html.PartialAsync("Components/_AdminPageDescription",
    "Money your group has taken, including what each payment was for.")

<div data-odk-component="_ChapterAdminPaymentsContent">
    @if (!Model.PaymentAccountEnabled)
    {
        <div class="alert alert-warning">
            <span>Your group cannot take money until its payment account is set up.</span>
            @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
            {
                Route = OdkRoutes.GroupAdmin.PaymentAccount(Model.Chapter),
                Text = "Set up payment account",
                UnauthorizedBehaviour = AdminLinkUnauthorizedBehaviour.Hide
            })
        </div>
    }

    <div class="table-responsive">
        <table class="table" data-sortable id="payments-table" data-table-striped>
            <thead>
                <tr>
                    <th data-sortable-sort="default" data-sortable-dir="desc">Date</th>
                    <th data-sortable-sort>Member</th>
                    <th>Reference</th>
                    <th>
                        Paid
                        @await Html.PartialAsync("Components/_Tooltip",
                            "What the member was charged.")
                    </th>
                    <th>
                        Received
                        @await Html.PartialAsync("Components/_Tooltip",
                            "Your share of what the member paid, less fees.")
                    </th>
                    <th>
                        Refunded
                        @await Html.PartialAsync("Components/_Tooltip",
                            "What has since been given back to the member.")
                    </th>
                    @* Refunding is a site-admin act, so the column is theirs alone. *@
                    @if (Model.ViewedBySiteAdmin)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Payments.Count == 0)
                {
                    <tr>
                        <td colspan="@columnCount" class="text-muted">No payments received yet.</td>
                    </tr>
                }

                @foreach (var item in Model.Payments)
                {
                    var (currency, member, payment) = (item.Payment.Currency, item.Member, item.Payment);

                    if (payment.PaidUtc == null)
                    {
                        continue;
                    }

                    <tr>
                        <td>
                            @* A friendly date does not sort as a date, so the cell carries the instant for the sorter. *@
                            <span class="d-none" data-sort-value="@payment.PaidUtc.Value.ToString("O", CultureInfo.InvariantCulture)"></span>
                            @payment.PaidUtc.Value.ToFriendlyDateString(dateTimeOptions)
                        </td>
                        <td>
                            <span class="d-none" data-sort-value="@member.FullName"></span>
                            @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
                            {
                                Route = OdkRoutes.GroupAdmin.MemberPayments(Model.Chapter, member.Id),
                                Text = member.FullName
                            })
                        </td>
                        <td>@payment.Reference</td>
                        <td>
                            @currency.ToAmountString(payment.Amount)
                        </td>
                        <td>
                            @* A dash rather than a zero: no share is recorded against this payment,
                               which is not the same as receiving nothing. *@
                            @(item.ChapterAmount != null
                                ? currency.ToAmountString(item.ChapterAmount.Value)
                                : "-")
                        </td>
                        <td>
                            @* An agreed refund that has not been paid yet is neither an amount nor
                               nothing, so it says so rather than reading as either. *@
                            @if (item.RefundedAmount != null)
                            {
                                <span>@currency.ToAmountString(item.RefundedAmount.Value)</span>
                            }
                            else if (item.HasRefund)
                            {
                                <span class="text-muted">Pending</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        @if (Model.ViewedBySiteAdmin)
                        {
                            <td>
                                @await Html.PartialAsync("Admin/Payments/_PaymentRefundButton", item)
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.ViewedBySiteAdmin)
    {
        @await Html.PartialAsync("Admin/Payments/_PaymentRefundModals", Model.Payments)
    }
</div>
