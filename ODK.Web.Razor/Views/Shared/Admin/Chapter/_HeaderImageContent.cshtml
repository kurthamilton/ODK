@using ODK.Services.Chapters
@using ODK.Web.Common.Routes
@using ODK.Web.Common.Services
@using ODK.Web.Razor.Models.Admin.Chapters
@inject IChapterSiteAdminService ChapterSiteAdminService
@inject IOdkRoutes OdkRoutes
@inject IRequestStore RequestStore
@{
    var viewModel = await ChapterSiteAdminService.GetChapterHeaderImageViewModel(
        RequestStore.MemberChapterServiceRequest);
}

<p class="text-muted">
    The image across the top of every page of this group. Upload it at the size it should be shown at -
    it is stored as it arrives.
</p>

@await Html.PartialAsync("Admin/Chapter/_ChapterAdminImage", new ChapterAdminImageViewModel
{
    FormAction = $"/groups/{viewModel.Chapter.Id}/header-image",
    Id = "chapter-header-image-modal",
    ImageAlt = "Group header image",
    ImageClass = "img-fluid",
    ImageUrl = viewModel.ImageVersion != null
        ? OdkRoutes.Groups.HeaderImage(viewModel.Chapter.Id, viewModel.ImageVersion.Value)
        : null,
    ModalTitle = "Change header image"
})
