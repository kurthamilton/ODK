@using ODK.Core.Images
@using ODK.Services.Chapters.ViewModels
@using ODK.Web.Razor.Models.Admin.Chapters
@model ChapterHeaderImageAdminPageViewModel

@await Html.PartialAsync("Components/_AdminPageDescription",
    "The image across the top of every page of this group. Upload it at the size it should be shown at - it is stored as it arrives.")

<form action="/groups/@Model.Chapter.Id/header-image" method="post">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("Admin/Chapter/_ImageForm", new ChapterImageFormViewModel
    {
        CurrentImageDataUrl = Model.Image != null
            ? ImageHelper.ToDataUrl(Model.Image.ImageData, Model.Image.MimeType)
            : null
    })
    <button class="btn btn-primary">Update</button>
</form>
