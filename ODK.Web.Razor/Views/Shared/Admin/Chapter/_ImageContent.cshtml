@using ODK.Core.Chapters
@using ODK.Services.Chapters.ViewModels
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Admin.Chapters
@model ChapterImageAdminPageViewModel
@inject IOdkRoutes OdkRoutes

@await Html.PartialAsync("Components/_AdminPageDescription",
    "The picture shown on your group page and wherever your group is listed.")

@await Html.PartialAsync("Admin/Chapter/_ChapterAdminImage", new ChapterAdminImageViewModel
{
    AspectRatio = ChapterImage.AspectRatio,
    FormAction = $"/groups/{Model.Chapter.Id}/image",
    Id = "chapter-image-modal",
    ImageAlt = "Group picture",
    ImageClass = "img-fluid",
    ImageUrl = Model.ImageVersion != null
        ? OdkRoutes.Groups.Image(Model.Chapter.Id, Model.ImageVersion.Value)
        : null,
    ModalTitle = "Change picture"
})
