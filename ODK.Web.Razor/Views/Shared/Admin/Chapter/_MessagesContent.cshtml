@using ODK.Core.Utils
@using ODK.Services.Chapters.ViewModels
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Admin
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Mvc
@model ChapterMessagesAdminPageViewModel
@inject IOdkRoutes OdkRoutes

@await Html.PartialAsync("Components/_AdminPageDescription",
    "Messages sent through your contact form by people who are not logged in.")

@await Html.PartialAsync("Admin/Chapter/_MessagesTabs", Model)

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Time</th>
                <th>From</th>
                <th>Message</th>
                <th>Replied</th>
                <th></th>
                <th class="tcol-narrow"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var message in Model.Messages.OrderByDescending(x => x.CreatedUtc))
            {
                var created = message.CreatedUtc.ToFriendlyDateTimeString(new FriendlyDateStringOptions 
                { 
                    IncludeDayOfWeek = true, 
                    TimeZone = Html.DisplayTimeZone(Model.Chapter.TimeZone) 
                });

                <tr>
                    <td>@created</td>
                    <td>@message.FromAddress</td>
                    <td>@message.Message</td>
                    <td>
                        @if (message.RepliedUtc != null)
                        {
                            @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.CheckCircle)
                            {
                                Class = "text-success"
                            })
                        }
                    </td>
                    <td>
                        @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
                        {
                            Route = OdkRoutes.GroupAdmin.Message(Model.Chapter, message.Id),
                            Text = "View"
                        })
                    </td>
                    <td>
                        <form method="post" action="/groups/@Model.Chapter.Id/messages/@message.Id/delete">
                            @Html.AntiForgeryToken()
                            @await Html.PartialAsync("Components/_Confirm", new ConfirmViewModel
                            {
                                Message = "Are you sure you want to delete this message?",
                                Title = "Delete message"
                            })
                            <button data-bs-toggle="tooltip" data-bs-title="Delete" class="btn-icon text-danger">
                                @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.Times))
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>