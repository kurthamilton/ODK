@using ODK.Web.Razor.Models.Admin.Chapters
@using System.Globalization
@model ChapterImageFormViewModel
@{
    var htmlAttributes = new Dictionary<string, object>
    {
        { "type", "file" },
        { "accept", "image/*" },
        { "class", "form-control" },
        { "data-img-input", "" }
    };

    // Razor drops an attribute whose only value is a null expression, and the cropper reads a missing
    // data-img-ratio as an unconstrained crop.
    var aspectRatio = Model.AspectRatio?.ToString(CultureInfo.InvariantCulture);
}

<div class="form-group mb-3">
    <div data-img-container>
        @Html.HiddenFor(x => x.ImageDataUrl, new { data_img_dataurl = "" })

        @Html.LabelFor(x => x.Image, new { @class = "form-label" })
        @Html.TextBoxFor(x => x.Image, htmlAttributes)
        @Html.ValidationMessageFor(x => x.Image)

        <div class="mt-3 @(string.IsNullOrEmpty(Model.CurrentImageDataUrl) ? "d-none" : null)" data-img-preview-container>
            <img src="@Model.CurrentImageDataUrl" data-img-preview data-img-resize data-img-ratio="@aspectRatio" />
        </div>
    </div>
</div>
