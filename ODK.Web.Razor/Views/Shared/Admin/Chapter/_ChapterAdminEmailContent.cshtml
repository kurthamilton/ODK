@using ODK.Core.Utils
@using ODK.Services.Emails.Parameters
@using ODK.Web.Common.Services
@using ODK.Web.Razor.Models.Admin.Chapters
@using ODK.Web.Razor.Models.Admin.Emails
@using ODK.Web.Razor.Models.Components
@model ChapterEmailContentViewModel
@inject IRequestStore RequestStore
@{
    // Each field holds what the group sends - the same fallback the send path applies, so the form shows the
    // email as it will go out rather than an empty box where the group has not overridden anything.
    var formViewModel = new ChapterEmailFormViewModel
    {
        CanOverride = Model.CanOverride,
        ContentHtml = StringUtils.Coalesce(Model.Email.BodyHtml, Model.SiteEmail.BodyHtml),
        InheritedContentHtml = Model.SiteEmail.BodyHtml,
        InheritedSubject = Model.SiteEmail.Subject,
        OverridesBody = Model.Email.OverridesBody,
        OverridesSubject = Model.Email.OverridesSubject,
        Placeholders = EmailTemplateParameters.ForGroup(Model.Email.Type),
        PreviewUrl = $"/groups/{Model.Chapter.Id}/emails/{Model.Email.Type}/preview",
        ValidPlaceholders = EmailTemplateParameters.ForSite(Model.Email.Type),
        Subject = StringUtils.Coalesce(Model.Email.Subject, Model.SiteEmail.Subject),
        ValidateUrl = $"/groups/{Model.Chapter.Id}/emails/{Model.Email.Type}/validate"
    };
}

@await Html.PartialAsync("Emails/_EmailBadges", new EmailBadgesViewModel
{
    Customised = !Model.Email.IsDefault(),
    RecipientType = Model.RecipientType
})

@if (Model.Email.IsDefault())
{
    @await Html.PartialAsync("Components/_AdminPageDescription",
    "Your own version of this email. Customise the subject, the body, or both.")

    <p>
        This group sends the default email below. Turn on <strong>Customise</strong> against the subject or
        the body to write your own; anything left alone keeps using the default and picks up any later
        changes to it.
    </p>
}

@* The upgrade prompt only: the form and its Update button render either way, because a group without the
   feature can still turn a customisation off - see UpdateChapterEmail, which is what enforces that rather
   than the markup. The form itself locks what cannot be written. *@
@if (!Model.CanOverride)
{
    <div class="mb-3">
        @await Html.PartialAsync("Components/_UpgradeButton", new UpgradeButtonViewModel
        {
            Chapter = Model.Chapter,
            Platform = RequestStore.Platform
        })
    </div>
}

<form method="post" action="/groups/@Model.Chapter.Id/emails/@Model.Email.Type">
    @Html.AntiForgeryToken()

    @await Html.PartialAsync("Admin/Chapter/_ChapterAdminEmailForm", formViewModel)

    <div class="button-container">
        <button class="btn btn-primary">Update</button>
    </div>
</form>

@* Empty but for its token: the toolbar's test button submits it, and it cannot be nested inside the form
   above. *@
<form method="post" action="/groups/@Model.Chapter.Id/emails/@Model.Email.Type/test"
      id="@EmailEditorElements.SendTestFormId">
    @Html.AntiForgeryToken()
</form>

@* At the bottom because it is reference material: an author consults it while writing the wording above,
   rather than reading it first. The insertable buttons beside the body field are the quick way to use one;
   this is where to find out what each of them does. *@
@await Html.PartialAsync("Components/_Section", new SectionViewModel
{
    Class = "mt-section",
    Heading = new HeadingViewModel
    {
        Title = "Placeholders",
        Type = HeadingType.H3
    },
    BodyContent = await Html.PartialAsync("Emails/_EmailParameters", Model.Parameters)
})

@await Html.PartialAsync("Emails/_EmailPreviewModal")