@using ODK.Core.Features
@using ODK.Services.Emails.Parameters
@using ODK.Web.Razor.Models.Admin.Chapters
@using ODK.Web.Razor.Models.Admin.Emails
@using ODK.Web.Razor.Models.Components
@model ChapterEmailContentViewModel
@{
    ChapterEmailFormViewModel FormViewModel(bool readOnly) => new()
    {
        Content = Model.Email.HtmlContent,
        Placeholders = EmailTemplateParameters.ForGroup(Model.Email.Type),
        ValidPlaceholders = EmailTemplateParameters.ForSite(Model.Email.Type),
        ReadOnly = readOnly,
        Subject = Model.Email.Subject,
        ValidateUrl = $"/groups/{Model.Chapter.Id}/emails/{Model.Email.Type}/validate"
    };
}

@await Html.PartialAsync("Admin/Chapter/_EmailRecipients", new EmailRecipientsViewModel
{
    RecipientType = Model.RecipientType,
    Title = Model.Title
})

@if (Model.Email.IsDefault())
{
    @await Html.PartialAsync("Components/_AdminPageDescription",
    "Your own version of this email. Leave it blank to keep using the standard one.")

    <p>
        Group emails use the standard emails by default. Update the email below to customise the email for this group.
    </p>
}
else
{
    <p>
        <span class="badge bg-secondary">Custom email</span>
    </p>
}

@* DisabledContentFunc rather than hiding the form: a group that already has a custom email keeps sending
   it, so the owner needs to see what is set even when they can no longer change it. The server enforces
   this too - see UpdateChapterEmail - so the read-only markup is presentation, not the guard.
   Sending a test and restoring the default stay available either way: neither writes new wording, and
   restoring puts the group back on the standard email it would have without the feature. *@
@await Html.PartialAsync("Components/_RestrictedFeature", new RestrictedFeatureViewModel(Model.CanEdit)
{
    Chapter = Model.Chapter,
    Feature = SiteFeatureType.CustomEmails,
    ContentFunc =
        @<form method="post" action="/groups/@Model.Chapter.Id/emails/@Model.Email.Type">
            @Html.AntiForgeryToken()

            @await Html.PartialAsync("Admin/Chapter/_EmailForm", FormViewModel(readOnly: false))

            <button class="btn btn-primary">Update</button>
            <button class="btn btn-secondary" type="button"
                    data-submit="#send-test-form"
                    data-bs-toggle="tooltip" data-bs-title="Send a test email to yourself">
                Send test
            </button>
            @if (!Model.Email.IsDefault())
            {
                <button class="btn btn-outline-light" type="button"
                        data-submit="#restore-default-form">
                    Restore default
                </button>
            }
        </form>,
    DisabledContentFunc =
        @<div class="mt-3">
            @await Html.PartialAsync("Admin/Chapter/_EmailForm", FormViewModel(readOnly: true))

            <button class="btn btn-secondary" type="button"
                    data-submit="#send-test-form"
                    data-bs-toggle="tooltip" data-bs-title="Send a test email to yourself">
                Send test
            </button>
            @if (!Model.Email.IsDefault())
            {
                <button class="btn btn-outline-light" type="button"
                        data-submit="#restore-default-form">
                    Restore default
                </button>
            }
        </div>
})

<form method="post" action="/groups/@Model.Chapter.Id/emails/@Model.Email.Type/test"
      id="send-test-form">
    @Html.AntiForgeryToken()
</form>

@if (!Model.Email.IsDefault())
{
    <form method="post" action="/groups/@Model.Chapter.Id/emails/@Model.Email.Type/restoreDefault"
          id="restore-default-form">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("Components/_Confirm", new ConfirmViewModel
        {
            Message = "Are you sure you want to delete this custom email and restore the default?",
            Title = "Restore default"
        })
    </form>
}
