@using ODK.Services.Chapters.ViewModels
@using ODK.Web.Razor.Models.Admin.Chapters
@model ChapterQuestionAdminPageViewModel

@await Html.PartialAsync("Components/_AdminPageDescription",
    "Change this question or its answer.")

<form method="post" action="/admin/groups/@Model.Chapter.Id/questions/@Model.Question.Id">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("Admin/Chapter/_ChapterAdminQuestionForm", new ChapterQuestionFormViewModel
    {
        AnswerHtml = Model.Question.AnswerHtml,
        Question = Model.Question.Name
    })
    <button class="btn btn-primary">Update</button>
</form>