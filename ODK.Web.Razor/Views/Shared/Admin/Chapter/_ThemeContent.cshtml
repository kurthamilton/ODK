@using ODK.Core.Features
@using ODK.Services.Chapters.ViewModels
@using ODK.Web.Razor.Models.Chapters.SiteAdmin
@using ODK.Web.Razor.Models.Components
@model ChapterThemeAdminPageViewModel
@{
    ThemeFormViewModel FormViewModel(bool readOnly) => new()
    {
        Background = Model.Chapter.ThemeBackground,
        Color = Model.Chapter.ThemeColor,
        ReadOnly = readOnly
    };
}

<p class="text-muted">Colours applied to your group's pages. Leave them unset to use the standard look.</p>

@* DisabledContentFunc rather than hiding the form: a group that already has a theme keeps rendering it,
   so the owner needs to see what is set even when they can no longer change it. The server enforces this
   too - see UpdateChapterTheme - so the read-only markup is presentation, not the guard. *@
@await Html.PartialAsync("Components/_RestrictedFeature", new RestrictedFeatureViewModel(Model.CanEdit)
{
    Chapter = Model.Chapter,
    Feature = SiteFeatureType.Theme,
    ContentFunc =
        @<form method="post" action="/groups/@Model.Chapter.Id/theme">
            @Html.AntiForgeryToken()

            @await Html.PartialAsync("Admin/Chapter/_ThemeForm", FormViewModel(readOnly: false))

            <button class="btn btn-primary">Update</button>
        </form>,
    DisabledContentFunc =
        @<div class="mt-3">
            @await Html.PartialAsync("Admin/Chapter/_ThemeForm", FormViewModel(readOnly: true))
        </div>
})
