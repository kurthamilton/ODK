@using ODK.Services.Subscriptions.ViewModels
@using ODK.Web.Razor.Models.Components
@model SiteSubscriptionCheckoutViewModel

@await Html.PartialAsync("Components/_AdminPageDescription",
    "Complete payment for this membership tier.")

<section data-odk-component="_ChapterSubscriptionCheckoutContent">
    @await Html.PartialAsync("Components/_StripeCheckout", new StripeCheckoutViewModel
    {
        ApiPublicKey = Model.ApiPublicKey,
        ClientSecret = Model.ClientSecret
    })    
</section>