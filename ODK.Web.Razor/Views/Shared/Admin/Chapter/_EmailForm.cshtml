@using ODK.Web.Razor.Models.Admin.Chapters
@using ODK.Web.Razor.Models.Admin.Emails
@using ODK.Web.Razor.Mvc
@model ChapterEmailFormViewModel

@* Each control carries its own disabled state rather than the form sitting in one <fieldset disabled>: a
   group that cannot write wording can still turn a customisation off, so the toggles have to stay live while
   the fields they control do not. A fieldset would disable its descendants whatever they say themselves.

   data-field-override-locked carries "true"/"false" rather than being present or absent. A null value drops
   checked and disabled below, but not a data- attribute: that renders as empty and present, so a script
   testing for presence reads every field as locked. Never give a data- attribute presence semantics here.

   Each field shows what the group sends: its own wording where it customises, the default otherwise. A field
   left on the default is disabled, so it posts nothing and stays inheriting - see odk.field-override.js.

   Each toggle posts its own state, which is what says whether the group overrides that field. It cannot be
   inferred from the wording arriving blank: a locked field posts nothing either, so the two would be
   indistinguishable and a save would clear wording the group never touched.

   Written out rather than through CheckBoxFor, which takes its attributes as a dictionary - and disabled
   cannot go through one, since a false value renders as present. Names come from NameFor so a renamed
   property breaks the build rather than the binding. *@
<div class="form-group mb-3">
    @Html.LabelFor(x => x.Subject, new { @class = "form-label" })

    <div class="form-check form-switch form-switch-sm">
        @* aria-label rather than the visible text alone: both toggles read "Customise", which beside their
           own field is clear enough to see but ambiguous read out on its own. *@
        <input class="form-check-input" type="checkbox" role="switch" id="override-subject"
               name="@Html.NameFor(x => x.OverrideSubject)" value="true"
               data-field-override="#Subject" aria-label="Customise subject"
               checked="@(Model.OverridesSubject ? "checked" : null)"
               disabled="@(Model.CanToggleSubject ? null : "disabled")"
               data-field-override-locked="@(Model.CanOverride ? "false" : "true")" />
        <label class="form-check-label" for="override-subject">Customise</label>
    </div>

    @Html.OdkEmailTemplateBoxFor(x => x.Subject, Model.ValidPlaceholders,
        disabled: !Model.CanEditSubject,
        htmlAttributes: new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.Subject)

    @* Shown as written rather than rendered: the default subject is a template in its own right, so it
       may still contain placeholders. Only while customised - otherwise it is what the box holds. *@
    @if (Model.OverridesSubject)
    {
        <div class="form-text">Default: <code>@Model.InheritedSubject</code></div>
    }
</div>

<div class="form-group mb-3">
    @Html.LabelFor(x => x.Content, new { @class = "form-label mb-0" })

    <div class="d-flex align-items-center flex-wrap gap-2 mb-1">        
        <div class="form-check form-switch form-switch-sm me-auto">
            @* The content field carries an explicit id, so this points at that rather than at the one the
           helper would have generated from the property name. *@
            <input class="form-check-input" type="checkbox" role="switch" id="override-content"
                   name="@Html.NameFor(x => x.OverrideContent)" value="true"
                   data-field-override="@EmailEditorElements.FieldSelector" aria-label="Customise body"
                   checked="@(Model.OverridesContent ? "checked" : null)"
                   disabled="@(Model.CanToggleContent ? null : "disabled")"
                   data-field-override-locked="@(Model.CanOverride ? "false" : "true")" />
            <label class="form-check-label" for="override-content">Customise</label>
        </div>

        @await Html.PartialAsync("Emails/_EmailEditorButtons", new EmailEditorButtonsViewModel
        {
            PreviewUrl = Model.PreviewUrl
        })
    </div>    

    @await Html.PartialAsync("Emails/_EmailPlaceholders", new EmailPlaceholdersViewModel
    {
        CanInsert = Model.CanOverride,
        Placeholders = Model.Placeholders
    })

    @* rows is the editor's minimum height - see odk.code-editor.js. *@
    @Html.OdkEmailTemplateTextAreaFor(x => x.Content, Model.ValidPlaceholders, Model.ValidateUrl,
        disabled: !Model.CanEditContent,
        htmlAttributes: new { @class = "form-control", rows = 5, id = EmailEditorElements.FieldId })

    @Html.ValidationMessageFor(x => x.Content)

    @* Collapsed, and only while customised: it is fifteen-odd lines of HTML, kept available so a group
       can compare its version against the default. Plain text in a pre, not the code editor, so it
       cannot be typed into. *@
    @if (Model.OverridesContent)
    {
        <details class="form-text">
            <summary>Default</summary>
            @* text-pre-wrap rather than the pre's own overflow: a scrollbar inside a small box is awkward for
               fifteen lines of HTML, and wrapping also stops the long lines widening the grid column. *@
            <pre class="border rounded p-2 mt-2 mb-0 text-pre-wrap"><code>@Model.InheritedContent</code></pre>
        </details>
    }
</div>
