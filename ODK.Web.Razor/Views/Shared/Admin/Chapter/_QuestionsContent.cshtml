@using ODK.Core.Platforms
@using ODK.Services.Chapters.ViewModels
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Admin
@using ODK.Web.Razor.Models.Components
@model ChapterQuestionsAdminPageViewModel
@inject IOdkRoutes OdkRoutes

@await Html.PartialAsync("Components/_AdminPageDescription", Model.Platform == PlatformType.DrunkenKnitwits
    ? "Questions and answers shown on your group's About page."
    : "Questions and answers shown on your group page, so members can find answers without asking.")

<p>
    @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
    {
        Class = "btn btn-primary",
        Icon = IconType.Plus,
        Route = OdkRoutes.GroupAdmin.QuestionCreate(Model.Chapter),
        Text = "Create question"
    })
</p>

@if (Model.Questions.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Question</th>
                    <th class="tcol-narrow"></th>
                    <th class="tcol-narrow"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var question in Model.Questions.OrderBy(x => x.DisplayOrder))
                {
                    <tr>
                        <td>
                            @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
                            {
                                Route = OdkRoutes.GroupAdmin.Question(Model.Chapter, question.Id),
                                Text = question.Name
                            })
                        </td>
                        <td>
                            <div class="d-flex">
                                <form method="post" action="/groups/@Model.Chapter.Id/questions/@question.Id/move/up">
                                    @Html.AntiForgeryToken()
                                    <button data-bs-toggle="tooltip" data-bs-title="Move up" class="btn btn-icon text-secondary">
                                        @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.ArrowCircleUp))
                                    </button>
                                </form>
                                <form method="post" action="/groups/@Model.Chapter.Id/questions/@question.Id/move/down">
                                    @Html.AntiForgeryToken()
                                    <button data-bs-toggle="tooltip" data-bs-title="Move down" class="btn btn-icon text-secondary">
                                        @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.ArrowCircleDown))
                                    </button>
                                </form>
                            </div>
                        </td>
                        <td>
                            <form method="post" action="/groups/@Model.Chapter.Id/questions/@question.Id/delete">
                                @Html.AntiForgeryToken()
                                @await Html.PartialAsync("Components/_Confirm", new ConfirmViewModel
                                {
                                    Message = "Are you sure you want to delete this question?",
                                    Title = "Delete question"
                                })
                                <button data-bs-toggle="tooltip" data-bs-title="Delete" class="btn-icon text-danger">
                                    @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.Times))
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}