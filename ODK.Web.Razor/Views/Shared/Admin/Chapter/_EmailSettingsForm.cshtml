@using ODK.Web.Razor.Models.Admin.Emails
@model ChapterEmailSettingsFormViewModel

@* One fieldset over both fields, so a group without the feature sees what is set without being able to
   change it - the same shape the template form uses. *@
<fieldset disabled="@(Model.ReadOnly ? "" : null)">
    <p class="text-muted">
        The wording emails use to refer to your group. Leave a box empty to use the site's.
    </p>

    <div class="row mb-3 gy-3">
        <div class="form-group col-md-6">
            @Html.LabelFor(x => x.MemberTitle, new { @class = "form-label" })
            @Html.TextBoxFor(x => x.MemberTitle, new { @class = "form-control" })
            @Html.ValidationMessageFor(x => x.MemberTitle)
        </div>

        <div class="form-group col-md-6">
            @Html.LabelFor(x => x.AdminTitle, new { @class = "form-label" })
            @Html.TextBoxFor(x => x.AdminTitle, new { @class = "form-control" })
            @Html.ValidationMessageFor(x => x.AdminTitle)
        </div>
    </div>
</fieldset>
