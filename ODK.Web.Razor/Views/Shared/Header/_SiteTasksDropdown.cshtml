@using ODK.Web.Common.Services
@inject IRequestStore RequestStore
@{
    if (RequestStore.CurrentMemberOrDefault == null)
    {
        return;
    }
}

@* Populated by odk.tasks.js from /tasks, like the notification list. Computing the tasks inline here cost
   two batches of queries on every page render, to fill a dropdown most members never open. *@
<div data-tasks-load="/tasks"></div>
