@using ODK.Core.Platforms
@using ODK.Web.Common.Routes
@using ODK.Web.Common.Services
@using ODK.Web.Razor.Models.Components
@inject IOdkRoutes OdkRoutes
@inject IRequestStore RequestStore
@{
    if (RequestStore.Platform != PlatformType.Default)
    {
        return;
    }

    var currentMember = RequestStore.CurrentMemberOrDefault;

    var menuItems = new List<MenuItem>
    {
        new MenuItem
        {
            Link = OdkRoutes.Groups.Index(),
            Text = "Groups"
        }
    };

    if (currentMember != null)
    {
        menuItems.Add(new MenuItem
        {
            Link = OdkRoutes.GroupAdmin.Index().Path,
            Text = "My groups"
        });
    }

    menuItems.Add(new MenuItem
    {
        Link = OdkRoutes.Site.Pricing,
        Text = "Pricing"
    });

    menuItems.Add(new MenuItem
    {
        Link = OdkRoutes.Site.About,
        Text = "About"
    });
}

<div data-odk-component="_SiteHeader">
    <nav class="navbar navbar-dark bg-dark text-light border-bottom border-light navbar-expand-md">
        <div class="container-md" data-site-header>
            <a href="/" class="navbar-brand">
                <img class="site-logo" src="/assets/groupsquirrel/logo3-outline.svg" />
            </a>            

            <div class="d-flex gap-4 ms-auto align-items-center order-md-5">
                @await Html.PartialAsync("Header/_SiteTasksDropdown")
                @await Html.PartialAsync("Header/_NotificationDropdown")
                @await Html.PartialAsync("Header/_SiteAccountDropdown")
                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#site-nav"
                        aria-controls="site-nav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            @await Html.PartialAsync("Components/_Offcanvas", new OffcanvasViewModel
            {
                Id = "site-nav",
                Breakpoint = "md",
                Position = "end",
                Class = "site-nav",
                Title = "",
                ContentFunc = @<ul class="navbar-nav">
                    @foreach (var menuItem in menuItems)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@menuItem.Link">@menuItem.Text</a>
                        </li>
                    }
                </ul>
            })
        </div>
    </nav>
</div>