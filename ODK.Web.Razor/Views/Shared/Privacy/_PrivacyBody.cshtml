@using ODK.Web.Razor.Models.Components

<div class="container-md">
    <div><em>Last Updated: 31 October 2018<br></em></div>
    <p>
        This Privacy Policy governs the collection, storage and use of personal data collected by us, the Drunken Knitwits,
        when you use our site and register as a member using our website at drunkenknitwits.com (the "<strong>Website</strong>").
        It provides you with details about the personal data we collect from you, how we use that personal data and your rights to control our use of personal data.
        Please read this Privacy Policy carefully.
        By visiting this Website (the "<strong>Services</strong>"), you confirm that you have read, understood and agree to this Privacy Policy in its entirety.
        If you do not agree to this Privacy Policy in its entirety, you must not use the Services.
    </p>

    <div class="section-stack mt-section">
        @await Html.PartialAsync("Components/_Section", new SectionViewModel
        {
            Heading = new HeadingViewModel
            {
                Title = "1. The personal data we collect",
                Type = HeadingType.H2
            },
            BodyContentFunc =
                @<div>
                    <p>When you use and browse the Services we collect the following information:</p>
                    <ul>
                        <li>Your name;</li>
                        <li>Your e-mail address;</li>
                        <li>Your profile photo;</li>
                    </ul>
                    <p>
                        When you join the Website, the profile information you enter and photo you upload will become viewable only to other logged in members who are using the Services.
                    </p>
                </div>
        })

        @await Html.PartialAsync("Components/_Section", new SectionViewModel
        {
            Heading = new HeadingViewModel
            {
                Title = "2. How we may store and use information",
                Type = HeadingType.H2
            },
            BodyContentFunc =
                @<div>
                    <p>We may collect, store and use personal data listed above relating to you for the following purposes:</p>
                    <ul>
                        <li>To make the Services available to you;</li>
                        <li>To maintain and support any customer account that you have with us;</li>
                    </ul>
                    <p><strong>We will not disclose, sell or rent personal data about you to any third party. </strong></p>
                </div>
        })

        @* Nothing in this repo links to #cookies - it is a published anchor for the cookies clause, so the
           id stays even though a find-usages here turns up nothing. *@
        @await Html.PartialAsync("Components/_Section", new SectionViewModel
        {
            Id = "cookies",
            Heading = new HeadingViewModel
            {
                Title = "3. Cookies",
                Type = HeadingType.H2
            },
            BodyContentFunc =
                @<p>
                    This Website uses cookies to collect information about you. Cookies are small data files which are placed on your computer by this
                    Website and which collect certain personal data about you.
                    This enables us to tailor our service offering (including the Website) to provide you with a better service.
                    However, you may change your website browser settings to reject cookies, although please note that if you or they do this it may
                    impair the functionality of the Services.
                    As each website browser is different, please visit your browser's "Help" menu to learn how to change your cookie preferences.
                </p>
        })

        @await Html.PartialAsync("Components/_Section", new SectionViewModel
        {
            Heading = new HeadingViewModel
            {
                Title = "4. Security",
                Type = HeadingType.H2
            },
            BodyContentFunc =
                @<p>
                    Whilst we take appropriate technical and organizational measures to safeguard the personal data that you provide to us,
                    no transmission over the Internet can ever be guaranteed secure.
                    Consequently, please note that we cannot guarantee the security of any personal data that you or they transfer over the Internet to us.
                </p>
        })

        @await Html.PartialAsync("Components/_Section", new SectionViewModel
        {
            Heading = new HeadingViewModel
            {
                Title = "5. Your rights",
                Type = HeadingType.H2
            },
            BodyContentFunc =
                @<div>
                    <p>You have the following rights:</p>
                    <ul>
                        <li>The right to ask us to provide you with copies of personal data that we hold about you at any time;</li>
                        <li>The right to ask us to update and correct any out-of-date or incorrect personal data that we hold about you free of charge;</li>
                        <li>The right to ask us to delete the personal data we hold about you;</li>
                    </ul>
                </div>
        })

        @await Html.PartialAsync("Components/_Section", new SectionViewModel
        {
            Heading = new HeadingViewModel
            {
                Title = "6. Changes to our Privacy Policy",
                Type = HeadingType.H2
            },
            BodyContentFunc =
                @<p>Any changes we make to our Privacy Policy in the future will be posted on this page.</p>
        })
    </div>
</div>
