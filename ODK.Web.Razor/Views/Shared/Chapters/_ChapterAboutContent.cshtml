@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.About
@using ODK.Web.Razor.Models.Chapters
@using ODK.Web.Razor.Models.Components
@model AboutContentViewModel
@inject IOdkRoutes OdkRoutes

<div class="section-stack">
    
    @if (!string.IsNullOrEmpty(Model.Texts?.Description))
    {
        <div>
            @Html.Raw(Model.Texts.Description)
        </div>
    }

    @await Html.PartialAsync("Components/_Section", new SectionViewModel
    {
        Heading = new HeadingViewModel
        {
            Title = "Frequently asked questions",
            Type = HeadingType.H3
        },
        BodyContentFunc =
            @<div>
                @await Html.PartialAsync("Chapters/_Questions", new ChapterQuestionsViewModel
                {
                    Chapter = Model.Chapter,
                    Questions = Model.Questions,
                    IsAdmin = false
                })

                <p class="mt-3">
                    Still have questions? Feel free to <a href="@OdkRoutes.Groups.Contact(Model.Chapter)">get in touch</a> before joining.
                </p>
            </div>
    })
</div>