@using ODK.Services.Chapters.ViewModels
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Admin
@using ODK.Web.Razor.Models.Components
@model ChapterSubscriptionsAdminPageViewModel
@inject IOdkRoutes OdkRoutes

@await Html.PartialAsync("Components/_AdminPageDescription",
    "Every subscription this group has, and the deployment each one was created under. The group's own subscriptions page hides any subscription that is disabled or cannot be bought; this one shows them.")

<div data-odk-component="_ChapterSubscriptionsContent">
    <div class="table-responsive">
        <table class="table" data-sortable id="site-admin-subscriptions-table" data-table-striped>
            <thead>
                <tr>
                    <th class="tcol-narrow"></th>
                    <th data-sortable-sort="default">Name</th>
                    <th>Amount</th>
                    <th>Months</th>
                    <th>Enabled</th>
                    <th>Environment</th>
                    <th>Visible to group</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Subscriptions.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-muted">This group has no subscriptions.</td>
                    </tr>
                }

                @foreach (var row in Model.Subscriptions)
                {
                    var subscription = row.ChapterSubscription;

                    <tr>
                        <td>
                            @if (subscription.Recurring)
                            {
                                <span data-bs-toggle="tooltip" title="Recurring subscription">
                                    @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.ArrowsSpin))
                                </span>
                            }
                        </td>
                        <td>
                            @* Sorting falls back to the cell's HTML, which would put the link's href ahead
                               of the text, so the name is stated for it explicitly. *@
                            <span class="d-none" data-sort-value="@subscription.Name"></span>
                            @await Html.PartialAsync("Admin/_AdminLink", new AdminLinkViewModel
                            {
                                Route = OdkRoutes.GroupAdmin.MembersSubscription(Model.Chapter, subscription),
                                Text = subscription.Name
                            })
                        </td>
                        <td>@subscription.Currency.ToAmountString(subscription.Amount)</td>
                        <td>@subscription.Months</td>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" disabled
                                       checked="@(!subscription.Disabled ? "" : null)" />
                            </div>
                        </td>
                        <td>@subscription.Environment</td>
                        <td>
                            @* Sorted on a stated value rather than the icon markup, which is identical for
                               every row that has one. *@
                            <span class="d-none" data-sort-value="@(row.VisibleToGroupAdmins ? 1 : 0)"></span>
                            @if (row.VisibleToGroupAdmins)
                            {
                                @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.Check))
                            }
                            else
                            {
                                <span class="text-danger" data-bs-toggle="tooltip"
                                      title="@(subscription.Disabled
                                          ? "Disabled, so this cannot be bought"
                                          : "Payments are switched off, so this cannot be bought")">
                                    @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.ExclamationTriangle))
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
