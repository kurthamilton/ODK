@using ODK.Services.Chapters.ViewModels
@using ODK.Web.Razor.Models.Chapters.SiteAdmin
@model ChapterPaymentSettingsAdminPageViewModel

<form method="post" action="/groups/@Model.Chapter.Id/siteadmin/payments">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("Chapters/SiteAdmin/_ChapterPaymentSettingsForm", new PaymentSettingsFormViewModel
    {
        CurrencyOptions = Model.Currencies,
        CurrencyId = Model.PaymentSettings?.CurrencyId
    })
    <button class="btn btn-primary">Update</button>
</form>
