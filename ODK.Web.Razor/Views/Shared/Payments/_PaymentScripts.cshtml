@using ODK.Core.Payments
@using ODK.Web.Razor.Models.Payments
@model PaymentScriptsViewModel

@foreach (var provider in Model.Providers.Distinct())
{
    @if (provider == PaymentProviderType.Stripe)
    {
        @* A pinned release channel, not /v3: initCheckoutElementsSdk (odk.stripe.js) needs the Basil release
           or higher, and /v3 resolves to an older one, failing at runtime with "You must upgrade to the Basil
           release or higher to use initCheckout". https://docs.stripe.com/sdks/stripejs-versioning *@
        <script src="https://js.stripe.com/dahlia/stripe.js"></script>
        <script src="~/js/odk.stripe.js" asp-append-version="true"></script>
    }
}