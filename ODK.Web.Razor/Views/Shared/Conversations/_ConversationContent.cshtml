@using ODK.Core.Utils
@using ODK.Web.Razor.Models.Chapters
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Models.Conversations
@model ConversationViewModel

@await Html.PartialAsync("Components/_Breadcrumbs", new BreadcrumbsViewModel
{
    Breadcrumbs = Model.Breadcrumbs
})

<div class="row mt-section">
    <div class="col-md-8">
        @if (Model.ArchivedUtc != null)
        {
            <div class="alert alert-info mb-3">
                <form method="post" action="@Model.RestoreUrl">
                    @Html.AntiForgeryToken()
                    <div class="d-flex align-items-center gap-2">
                        <span>Archived @Model.ArchivedUtc.Value.ToRelativeTime(Model.TimeZone).</span>
                        <button class="btn btn-link px-0" type="submit">Restore</button>
                    </div>
                </form>
            </div>
        }

        <section class="section">
            @await Html.PartialAsync("Components/_Panel", new PanelViewModel
            {
                TitleContentFunc = @<h5>Messages</h5>,
                BodyContentFunc = 
                    @<div>
                        @await Html.PartialAsync("Conversations/_ConversationMessages", new ConversationMessagesViewModel
                        {
                            CurrentMember = Model.CurrentMember,
                            Messages = Model.Messages
                        })
                    </div>
            })    
        </section>

        <section class="section">
            @await Html.PartialAsync("Components/_Panel", new PanelViewModel
            {
                TitleContentFunc = @<h5>Reply</h5>,
                BodyContentFunc = 
                    @<div>
                        <form action="@Model.ReplyUrl" method="post">
                            @Html.AntiForgeryToken()
                            @await Html.PartialAsync("Conversations/_ChapterConversationReplyForm", new ChapterConversationReplyFormViewModel())
                            
                            <div class="d-flex">
                                <button class="btn btn-primary" type="submit">Send</button>

                                @if (Model.ArchivedUtc == null)
                                {
                                    <button class="btn btn-secondary ms-auto" type="button"
                                        data-submit="#archive-conversation-form">
                                        @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.Archive))
                                        <span>Archive</span>
                                    </button>
                                }
                            </div>                            
                        </form>

                        @if (Model.ArchivedUtc == null)
                        {
                            <form id="archive-conversation-form" method="post" action="@Model.ArchiveUrl">
                                @Html.AntiForgeryToken()
                                @await Html.PartialAsync("Components/_Confirm", new ConfirmViewModel
                                {
                                    Message = "Are you sure you want to archive this conversation?",
                                    Title = "Archive conversation"
                                })
                            </form>
                        }                        
                    </div>
            })
        </section>        
    </div>

    <div class="col-md-4 mt-section mt-md-0">
        @if (Model.OtherConversations.Count > 0)
        {
            @await Html.PartialAsync("Components/_Panel", new PanelViewModel
            {
                TitleContentFunc = @<h5>Other conversations</h5>,
                BodyContentFunc = 
                    @<div class="list-group">
                        @foreach (var conversation in Model.OtherConversations.OrderByDescending(x => x.LastMessageUtc))
                        {
                            <div class="list-group-item">
                                <div>
                                    <a href="@Model.ConversationUrlFunc(conversation.Id)">
                                        @conversation.Subject
                                    </a>
                                </div>
                                <div class="small d-flex">
                                    <span class="me-auto">
                                        @conversation.LastMessageUtc.ToFriendlyDateTimeString(new FriendlyDateStringOptions 
                                        { 
                                            IncludeDayOfWeek = true, 
                                            TimeZone = Model.TimeZone 
                                        })
                                    </span>
                                    <span>
                                        <span data-bs-toggle="tooltip" data-bs-title="Messages">
                                            @await Html.PartialAsync("Components/_Icon", new IconViewModel(IconType.Comments))
                                        </span>
                                        <span>@conversation.MessageCount</span>
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
            })
        }
    </div>
</div>
