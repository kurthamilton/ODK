@using ODK.Services.Members.ViewModels
@using ODK.Web.Common.Routes
@using ODK.Web.Razor.Models.Components
@model ChapterSubscriptionCheckoutStartedViewModel
@inject IOdkRoutes OdkRoutes

<div>
    @await Html.PartialAsync("Components/_Breadcrumbs", new BreadcrumbsViewModel
    {
        Breadcrumbs = new[]
        {
            new MenuItem { Text = "My subscription", Link = OdkRoutes.Groups.Subscription(Model.Chapter) },
            new MenuItem { Text = Model.ChapterSubscription.Title },
            new MenuItem { Text = "Checkout" }
        }
    })
    <h2 class="content-heading">Checkout</h2>
    @await Html.PartialAsync("Components/_StripeCheckout", new StripeCheckoutViewModel
    {
        ApiPublicKey = Model.PaymentSettings.ApiPublicKey,
        ClientSecret = Model.ClientSecret
    })
</div>