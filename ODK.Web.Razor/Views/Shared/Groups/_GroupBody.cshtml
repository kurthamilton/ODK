@using Microsoft.AspNetCore.Html
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Models.Groups
@model GroupBodyViewModel
@{
    var memberChapter = Model.Group.CurrentMember?.MemberChapter(Model.Group.Chapter.Id);

    // Identical for both layouts below - only the component wrapping it differs (sidebar or not).
    Func<object?, IHtmlContent> content = @<div>
        @* Only whoever can still reach an unpublished group sees this, so the check is the published state
           itself rather than a role. Positioned against the .preview-label-container wrapper that _Body /
           _BodyWithSidebar put around the page container, so it lands on the page edge below the title
           rather than inset by this column. *@
        @if (!Model.Group.Chapter.IsPublished())
        {
            <div class="preview-label">
                <span>Preview</span>
            </div>
        }

        @if (memberChapter != null)
        {
            @await Html.PartialAsync("Chapters/_ApprovalWarning", memberChapter)
        }

        @if (!string.IsNullOrEmpty(Model.Title))
        {
            <h2 class="content-heading">@Model.Title</h2>
        }

        @Model.Content
    </div>;
}

@if (Model.SidebarContent != null)
{
    @await Html.PartialAsync("Components/_BodyWithSidebar", new BodyWithSidebarViewModel
    {
        Breadcrumbs = Model.Breadcrumbs,
        Menu = await Html.PartialAsync("Groups/_GroupMenu", Model.Group),
        SidebarContent = Model.SidebarContent,
        TitleContent = await Html.PartialAsync("Groups/_GroupTitle", Model.Group.Chapter),
        ContentFunc = content
    })
}
else
{
    @await Html.PartialAsync("Components/_Body", new BodyViewModel
    {
        Breadcrumbs = Model.Breadcrumbs,
        Menu = await Html.PartialAsync("Groups/_GroupMenu", Model.Group),
        TitleContent = await Html.PartialAsync("Groups/_GroupTitle", Model.Group.Chapter),
        ContentFunc = content
    })
}