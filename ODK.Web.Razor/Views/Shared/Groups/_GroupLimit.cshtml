@using ODK.Core.Utils
@using ODK.Services.Chapters.ViewModels
@using ODK.Web.Common.Services
@using ODK.Web.Razor.Models.Components
@model GroupLimitViewModel
@inject IRequestStore RequestStore
@{
    var (count, limit, remaining) = (Model.Count, Model.Limit, Model.Remaining);

    var groups = limit != null ? StringUtils.Pluralise(limit.Value, "group") : string.Empty;

    // The opening every message with a count to report shares: "You have 2 of 3 groups".
    string Owned() => $"You have {count} of {limit} {groups}";

    string? message = remaining switch
    {
        null => null,
        0 => count > 0
            ? $"{Owned()}, so you cannot create another."
            : $"Your group limit is {limit}, so you cannot create a group.",
        1 => count > 0
            ? $"{Owned()}. This is the last one you can create."
            : $"You can create {limit} {groups}.",
        _ => count > 0
            ? $"{Owned()}."
            : $"You can create up to {limit} {groups}."
    };

    // Doubles as the switch between an alert and a plain paragraph: only a limit the member is
    // up against warrants an alert.
    string? alertClass = remaining switch
    {
        0 => "alert-danger",
        1 => "alert-warning",
        _ => null
    };
}

@if (message != null)
{
    <div class="mb-3" data-odk-component="_GroupLimit">
        @if (alertClass != null)
        {
            <div class="alert @alertClass mb-0">
                @message
            </div>
        }
        else
        {
            <p class="mb-0">
                @message
            </p>
        }

        @* Not a feature gate - the subscription allows groups, there are just none left - so this
           doesn't go through _RestrictedFeature. It's still the same upgrade action, so it uses the
           shared button rather than a second hand-rolled one. *@
        @if (remaining == 0)
        {
            <div class="mt-3">
                @await Html.PartialAsync("Components/_UpgradeButton", new UpgradeButtonViewModel
                {
                    Chapter = null,
                    Platform = RequestStore.Platform
                })
            </div>
        }
    </div>
}
