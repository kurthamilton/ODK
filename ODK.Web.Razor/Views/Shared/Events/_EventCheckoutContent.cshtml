@using ODK.Services.Events.ViewModels
@using ODK.Web.Razor.Models.Components
@using ODK.Web.Razor.Models.Events
@model EventCheckoutPageViewModel

@await Html.PartialAsync("Events/_EventHeader", new EventHeaderViewModel
{
    Chapter = Model.Chapter,
    Event = Model.Event,
    Venue = Model.Venue
})

<section class="section">
    @await Html.PartialAsync("Components/_StripeCheckout", new StripeCheckoutViewModel
    {
        ApiPublicKey = Model.PaymentSettings.ApiPublicKey,
        ClientSecret = Model.ClientSecret
    })    
</section>