<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>aspnet-ODK.Web.Razor-885db159-c982-4fde-b49e-baf69b1293fb</UserSecretsId>
		<DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**</DefaultItemExcludes>

		<!-- Every generated client asset: the vendored libraries copied out of node_modules, the CSS compiled
		     from wwwroot\scss, and the script bundles. All three are gitignored, and none may come from the
		     default Content glob: globs are expanded when the project is evaluated, before any target has run,
		     so on a clean checkout the files do not exist yet and would be absent from the build and publish
		     output. BuildClientAssets adds them as Content after generating them instead. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\lib\**</DefaultItemExcludes>
		<DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\css\**</DefaultItemExcludes>
		<DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\js\odk.bundle*.js</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ODK.Web.Razor.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- The SCSS sources. A build compiles them, so nothing dotnet watch does should react to an edit -
		     see run.build.css.bat, the fast path for recompiling mid-session. Note this keeps them out of the
		     watch list only - the build still enumerates and hashes everything under wwwroot as a static web
		     asset, which is why a sass watcher must not run alongside dotnet watch (see run.app.bat).

		     The generated CSS and bundles need no entry here. They are excluded from the default glob above
		     and added by BuildClientAssets with Watch="false" already on them. The bundles' *sources* are
		     deliberately left watched: a build is what regenerates a bundle, so a script edit has to be able
		     to trigger one. -->
		<Content Update="wwwroot\scss\**" Watch="false" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Pages\Groups\Admin\**" />
		<Content Remove="Pages\Groups\Admin\**" />
		<EmbeddedResource Remove="Pages\Groups\Admin\**" />
		<None Remove="Pages\Groups\Admin\**" />
	</ItemGroup>

	<!-- Produces every generated client asset and hands it to the build as Content: restores the vendored
	     browser libraries from npm into wwwroot\lib, compiles wwwroot\scss into wwwroot\css, and builds the
	     CSS and JavaScript bundles the layouts reference. Runs before the SDK turns Content into static web
	     assets, which is the step that puts them into the build and the publish output.

	     Because every one of those outputs is produced here, a deployed artifact never depends on what a
	     developer happened to have compiled locally - which is why none of them is committed.

	     Order is not incidental: the SCSS imports Bootstrap's own sources out of wwwroot\lib, and some
	     bundles are built from what is copied there, so the copy has to have happened first.

	     The two sass scripts are run rather than build:css, whose prebuild hook would copy the client
	     libraries a second time.

	     No Inputs/Outputs: the two node scripts are their own up-to-date check - the copy fingerprints the
	     installed package versions and its own source, and the bundler writes only a file whose contents
	     have changed. Sass has no such check and recompiles every time, which is the bulk of what this
	     target costs when there is nothing to do. Skipped for a design-time build so opening the project in
	     Visual Studio never waits on npm. -->
	<Target Name="BuildClientAssets" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(DesignTimeBuild)' != 'true'">
		<Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="!Exists('$(MSBuildProjectDirectory)\node_modules\.package-lock.json')" />
		<Exec Command="node build/copy-client-libs.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Command="npm run sass:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Command="npm run sass:min" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Command="node build/build-bundles.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />

		<ItemGroup>
			<!-- Watch="false": nobody edits these, and a build rewriting files dotnet watch is watching takes
			     the watcher down. -->
			<Content Include="wwwroot\lib\**" Exclude="wwwroot\lib\.client-libs.json" Watch="false" />
			<Content Include="wwwroot\css\**" Watch="false" />
			<Content Include="wwwroot\js\odk.bundle*.js" Watch="false" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="BetterStack.Logs.Serilog" Version="1.2.0" />
		<PackageReference Include="GitInfo" Version="3.6.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Hangfire.AspNetCore" Version="1.8.24" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
		<PackageReference Include="Hangfire.SqlServer" Version="1.8.24" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Enrichers.ClientInfo" Version="2.9.0" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Serilog.Sinks.MSSqlServer" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="wwwroot\assets\stock\" />
		<Folder Include="wwwroot\css\" />
		<Folder Include="wwwroot\lib\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ODK.Core\ODK.Core.csproj" />
		<ProjectReference Include="..\ODK.Data.EntityFramework.Migrations\ODK.Data.EntityFramework.Migrations.csproj" />
		<ProjectReference Include="..\ODK.Infrastructure\ODK.Infrastructure.csproj" />
		<ProjectReference Include="..\ODK.Web.Common\ODK.Web.Common.csproj" />
	</ItemGroup>
</Project>