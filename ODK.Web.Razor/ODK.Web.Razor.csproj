<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>aspnet-ODK.Web.Razor-885db159-c982-4fde-b49e-baf69b1293fb</UserSecretsId>
		<DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**</DefaultItemExcludes>

		<!-- wwwroot\lib is a build output - build\copy-client-libs.mjs writes it from node_modules, and it is
		     gitignored. It must not come from the default Content glob: globs are expanded when the project is
		     evaluated, before any target has run, so on a clean checkout the directory is still empty and the
		     libraries would be absent from the build and publish output. RestoreClientLibraries adds them
		     after the copy instead. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\lib\**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ODK.Web.Razor.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- Generated output and its source: nothing dotnet watch does should react to either, so a css
		     rebuild never restarts the app. Note this keeps them out of the watch list only - the build still
		     enumerates and hashes everything under wwwroot as a static web asset, which is why a sass watcher
		     must not run alongside dotnet watch (see run.app.bat). -->
		<Content Update="wwwroot\scss\**" Watch="false" />
		<Content Update="wwwroot\css\**" Watch="false" />

		<!-- The generated bundles, for the same reason. Their sources are deliberately left watched: a build
		     is what regenerates a bundle, so a script edit has to be able to trigger one. Watching the outputs
		     as well would make the build's own write look like a further change. -->
		<Content Update="wwwroot\js\odk.bundle*.js" Watch="false" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Pages\Groups\Admin\**" />
		<Content Remove="Pages\Groups\Admin\**" />
		<EmbeddedResource Remove="Pages\Groups\Admin\**" />
		<None Remove="Pages\Groups\Admin\**" />
	</ItemGroup>

	<!-- Restores the vendored browser libraries from npm into wwwroot\lib, hands them to the build as
	     Content, and builds the CSS and JavaScript bundles the layouts reference. Runs before the SDK turns
	     Content into static web assets, which is the step that puts them into the build and the publish
	     output.

	     Order is not incidental: some bundles are built from wwwroot\lib, so the copy has to have happened.

	     No Inputs/Outputs: each script is its own up-to-date check - the copy fingerprints the installed
	     package versions and its own source, and the bundler writes only a file whose contents have changed -
	     so a build with nothing to do costs two node startups. Skipped for a design-time build so opening the
	     project in Visual Studio never waits on npm. -->
	<Target Name="RestoreClientLibraries" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(DesignTimeBuild)' != 'true'">
		<Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="!Exists('$(MSBuildProjectDirectory)\node_modules\.package-lock.json')" />
		<Exec Command="node build/copy-client-libs.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Command="node build/build-bundles.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />

		<ItemGroup>
			<!-- Watch="false" for the same reason as the generated CSS above: nobody edits these, and a build
			     rewriting files dotnet watch is watching takes the watcher down. -->
			<Content Include="wwwroot\lib\**" Exclude="wwwroot\lib\.client-libs.json" Watch="false" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="BetterStack.Logs.Serilog" Version="1.2.0" />
		<PackageReference Include="GitInfo" Version="3.6.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Hangfire.AspNetCore" Version="1.8.24" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
		<PackageReference Include="Hangfire.SqlServer" Version="1.8.24" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Enrichers.ClientInfo" Version="2.9.0" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Serilog.Sinks.MSSqlServer" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="wwwroot\assets\stock\" />
		<Folder Include="wwwroot\lib\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ODK.Core\ODK.Core.csproj" />
		<ProjectReference Include="..\ODK.Data.EntityFramework.Migrations\ODK.Data.EntityFramework.Migrations.csproj" />
		<ProjectReference Include="..\ODK.Infrastructure\ODK.Infrastructure.csproj" />
		<ProjectReference Include="..\ODK.Web.Common\ODK.Web.Common.csproj" />
	</ItemGroup>
</Project>