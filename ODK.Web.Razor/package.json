{
  "name": "odk.web.razor",
  "version": "1.0.0",
  "private": true,
  "description": "Client-side build pipeline for ODK.Web.Razor: the vendored browser libraries (build/copy-client-libs.mjs), the SCSS build (Dart Sass) and the CSS/JS bundles (build/build-bundles.mjs, esbuild).",
  "scripts": {
    "build:lib": "node build/copy-client-libs.mjs",
    "prebuild:bundles": "npm run build:lib",
    "build:bundles": "node build/build-bundles.mjs",
    "sass:css": "sass wwwroot/scss/main.scss:wwwroot/css/main.css wwwroot/scss/odk.scss:wwwroot/css/odk.css --style=expanded --no-source-map --quiet-deps --silence-deprecation=import,global-builtin,slash-div,color-functions,if-function",
    "sass:min": "sass wwwroot/scss/main.scss:wwwroot/css/main.min.css wwwroot/scss/odk.scss:wwwroot/css/odk.min.css --style=compressed --no-source-map --quiet-deps --silence-deprecation=import,global-builtin,slash-div,color-functions,if-function",
    "prebuild:css": "npm run build:lib",
    "build:css": "npm run sass:css && npm run sass:min",
    "watch:css": "sass wwwroot/scss/main.scss:wwwroot/css/main.css wwwroot/scss/odk.scss:wwwroot/css/odk.css --style=expanded --no-source-map --quiet-deps --silence-deprecation=import,global-builtin,slash-div,color-functions,if-function --watch --update",
    "watch:min": "sass wwwroot/scss/main.scss:wwwroot/css/main.min.css wwwroot/scss/odk.scss:wwwroot/css/odk.min.css --style=compressed --no-source-map --quiet-deps --silence-deprecation=import,global-builtin,slash-div,color-functions,if-function --watch --update",
    "prewatch:sass": "npm run build:lib",
    "watch:sass": "concurrently -k -n css,min -c green,cyan \"npm:watch:css\" \"npm:watch:min\""
  },
  "dependencies": {
    "@eastdesire/jscolor": "2.5.2",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@microsoft/signalr": "10.0.11",
    "ace-builds": "1.44.0",
    "aspnet-client-validation": "0.11.1",
    "bootstrap": "5.3.8",
    "cookieconsent": "3.1.1",
    "cropperjs": "2.2.0",
    "flatpickr": "4.6.13",
    "mermaid": "11.17.2",
    "slim-select": "4.2.3",
    "tinymce": "8.9.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "esbuild": "0.28.2",
    "sass": "1.104.0"
  }
}
